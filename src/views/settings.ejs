<!DOCTYPE html>
<html lang="ru">
<head><%- include('partials/subscription-head', { title: `Настройки — ${appName}` }) %></head>
<body class="bg-slate-100 text-slate-900">
  <%- include('partials/subscription-header', { heading: 'Настройки' }) %>
  <main id="main" class="mx-auto max-w-3xl px-4 py-6 md:py-8">
    <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm md:p-7">
      <h2 class="text-lg font-semibold">Настройки проверки VPN и HTTP-прокси</h2>
      <p class="mt-1 text-sm text-gray-600">Интервалы сохраняются в приложении и имеют приоритет над переменными окружения.</p>
      <% if (error) { %><p class="mt-3 rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700"><%= error %></p><% } %>
      <% if (success) { %><p class="mt-3 rounded-lg bg-green-50 px-3 py-2 text-sm text-green-700">Настройки сохранены. Новые проверки будут использовать обновлённый прокси.</p><% } %>
      <% if (recheckJobs !== null) { %><p class="mt-3 rounded-lg bg-blue-50 px-3 py-2 text-sm text-blue-700">Запущено перепроверка узлов: <%= recheckJobs %> задач(а).</p><% } %>
      <form method="post" action="/admin/settings" class="mt-5 space-y-4">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div>
          <label class="block text-sm font-medium mb-1" for="checkIntervalSeconds">Интервал VPN-проверок, секунд</label>
          <input id="checkIntervalSeconds" name="checkIntervalSeconds" type="number" min="30" max="86400" step="1" value="<%= checkIntervalSeconds %>" required class="w-full rounded-lg border border-slate-300 px-3 py-2">
          <p class="mt-1 text-xs text-gray-500">Например, 3600 — проверка не чаще одного раза в час.</p>
        </div>
        <div>
          <label class="block text-sm font-medium mb-1" for="healthyTtlSeconds">Срок актуальности результата, секунд</label>
          <input id="healthyTtlSeconds" name="healthyTtlSeconds" type="number" min="60" max="604800" step="1" value="<%= healthyTtlSeconds %>" required class="w-full rounded-lg border border-slate-300 px-3 py-2">
          <p class="mt-1 text-xs text-gray-500">Должен быть больше интервала VPN-проверок.</p>
        </div>
        <details class="rounded-lg border border-slate-200 p-3">
          <summary class="cursor-pointer font-medium">Дополнительные настройки проверки</summary>
          <div class="mt-4 grid gap-4 sm:grid-cols-2">
            <% const editable = [
              ['sourceTimeoutSeconds', 'Таймаут загрузки источника, секунд', 1, 120],
              ['readyTimeoutSeconds', 'Таймаут запуска Xray, секунд', 1, 30],
              ['attemptTimeoutSeconds', 'Таймаут попытки VPN-проверки, секунд', 1, 30],
              ['deadlineSeconds', 'Общий таймаут VPN-проверки, секунд', 5, 180],
              ['probeConcurrency', 'Параллельные VPN-проверки', 1, 64],
              ['syncConcurrency', 'Параллельные загрузки источников', 1, 8],
              ['maxQueued', 'Максимум задач в очереди', 1, 20000],
              ['historyDays', 'Хранить историю, дней', 1, 30],
              ['maxHistoryRows', 'Максимум записей истории', 100, 200000]
            ]; %>
            <% editable.forEach(([name, label, min, max]) => { %>
              <div><label class="block text-sm font-medium mb-1" for="<%= name %>"><%= label %></label><input id="<%= name %>" name="<%= name %>" type="number" min="<%= min %>" max="<%= max %>" step="1" value="<%= locals[name] %>" required class="w-full rounded-lg border border-slate-300 px-3 py-2"></div>
            <% }); %>
          </div>
        </details>
        <div>
          <label class="block text-sm font-medium mb-1" for="proxyUrl">URL прокси</label>
          <input id="proxyUrl" name="proxyUrl" type="text" value="<%= proxyUrl %>" placeholder="http://user:pass@host:port" class="w-full rounded-lg border border-slate-300 px-3 py-2">
          <p class="mt-1 text-xs text-gray-500">Поддерживается http:// и https://. Оставьте пустым, чтобы отключить.</p>
        </div>
        <div>
          <label class="block text-sm font-medium mb-1" for="proxyMode">Режим проверки</label>
          <select id="proxyMode" name="proxyMode" class="w-full rounded-lg border border-slate-300 px-3 py-2">
            <option value="extra" <%= proxyMode === 'extra' ? 'selected' : '' %>>Дополнительно (extra)</option>
            <option value="only" <%= proxyMode === 'only' ? 'selected' : '' %>>Только через прокси (only)</option>
          </select>
        </div>
        <div class="flex flex-wrap items-center gap-3 pt-2">
          <button type="submit" class="rounded-lg bg-blue-700 px-4 py-2 font-semibold text-white hover:bg-blue-800">Сохранить</button>
          <button type="button" id="checkProxyBtn" class="rounded-lg border border-slate-300 px-4 py-2 font-semibold text-slate-700 hover:bg-slate-50">Проверить прокси</button>
        </div>
      </form>
      <% if (proxyStats.configured) { %>
        <div class="mt-5 rounded-xl border border-slate-200 bg-slate-50 p-4">
          <h3 class="text-sm font-semibold text-slate-700">Доступность узлов через прокси</h3>
          <div class="mt-2 grid grid-cols-2 gap-2 text-sm sm:grid-cols-4">
            <div class="rounded-lg bg-green-100 px-3 py-2 text-green-800">Доступно: <strong><%= proxyStats.healthy %></strong></div>
            <div class="rounded-lg bg-red-100 px-3 py-2 text-red-800">Недоступно: <strong><%= proxyStats.failed %></strong></div>
            <div class="rounded-lg bg-amber-100 px-3 py-2 text-amber-800">Устарело: <strong><%= proxyStats.stale %></strong></div>
            <div class="rounded-lg bg-gray-200 px-3 py-2 text-gray-700">Не проверено: <strong><%= proxyStats.unchecked %></strong></div>
          </div>
          <p class="mt-2 text-xs text-gray-500">Всего активных узлов: <%= proxyStats.total %></p>
          <form method="post" action="/admin/settings/recheck" class="mt-3">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="rounded-lg border border-blue-300 bg-white px-4 py-2 text-sm font-semibold text-blue-700 hover:bg-blue-50">Перепроверить все узлы</button>
          </form>
        </div>
      <% } %>
      <div id="proxyResult" class="mt-4 hidden rounded-lg border p-3 text-sm"></div>
      <div class="mt-6 border-t pt-4">
        <h3 class="text-sm font-semibold text-gray-700">Статус Xray</h3>
        <p class="mt-1 text-sm text-gray-600"><%= runner.available ? `Доступен, версия ${runner.version}` : runner.error || 'Не проверен' %></p>
      </div>
    </section>
  </main>
  <script>
    document.getElementById('checkProxyBtn').addEventListener('click', async () => {
      const out = document.getElementById('proxyResult');
      out.className = 'mt-4 rounded-lg border p-3 text-sm bg-slate-50 text-slate-700';
      out.textContent = 'Проверка…';
      out.classList.remove('hidden');
      try {
        const response = await fetch('/api/settings/proxy/check', {
          method: 'POST',
          headers: { 'x-csrf-token': document.querySelector('meta[name="csrf-token"]').content }
        });
        const data = await response.json();
        if (!response.ok) throw new Error(data.error || 'Ошибка проверки');
        if (data.status === 'healthy') {
          out.className = 'mt-4 rounded-lg border border-green-200 bg-green-50 p-3 text-sm text-green-700';
          out.textContent = `Прокси работает. Задержка: ${Math.round(data.latencyMs)} мс`;
        } else {
          out.className = 'mt-4 rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-700';
          out.textContent = `Прокси недоступен: ${data.errorCode || 'unknown'}`;
        }
      } catch (error) {
        out.className = 'mt-4 rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-700';
        out.textContent = error.message;
      }
    });
  </script>
</body>
</html>
