<!DOCTYPE html>
<html lang="<%= locale %>">
<head><%- include('partials/subscription-head', { title: `${t('Настройки')} — ${appName}` }) %></head>
<body class="bg-slate-100 text-slate-900">
  <%- include('partials/subscription-header', { heading: t('Настройки') }) %>
  <main id="main" class="mx-auto max-w-6xl px-4 py-6 md:py-8">
    <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm md:p-7">
      <h2 class="text-lg font-semibold"><%= t('Настройки проверки VPN и HTTP-прокси') %></h2>
      <p class="mt-1 text-sm text-gray-600"><%= t('Интервалы сохраняются в приложении и имеют приоритет над переменными окружения.') %></p>
      <% if (error) { %><p class="mt-3 rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700"><%= error %></p><% } %>
      <% if (success) { %><p class="mt-3 rounded-lg bg-green-50 px-3 py-2 text-sm text-green-700"><%= t('Настройки сохранены. Новые проверки будут использовать обновлённый прокси.') %></p><% } %>
      <% if (recheckJobs !== null) { %><p class="mt-3 rounded-lg bg-blue-50 px-3 py-2 text-sm text-blue-700"><%= t('Запущено перепроверка узлов: {count} задач(а).', { count: recheckJobs }) %></p><% } %>
      <div class="mt-5 rounded-lg border border-slate-200 p-4">
        <label class="block text-sm font-medium mb-1" for="languageSelect"><%= t('Язык интерфейса') %></label>
        <select id="languageSelect" class="w-full rounded-lg border border-slate-300 px-3 py-2" onchange="window.location.href = this.value">
          <option value="<%= languageUrl('ru') %>" <%= locale === 'ru' ? 'selected' : '' %>><%= t('Русский') %></option>
          <option value="<%= languageUrl('en') %>" <%= locale === 'en' ? 'selected' : '' %>><%= t('English') %></option>
        </select>
      </div>
      <% if (typeof probeBudget !== 'undefined') { %>
      <p class="mt-4 text-sm text-gray-600" data-probe-budget>
        Deadline (<%= deadlineMode %>): <%= probeBudget.deadlineMs / 1000 %> s.
        <%= t('Расчётный бюджет полного плана') %>: <%= probeBudget.requiredMs / 1000 %> s.
        <% if (probeBudget.constrained) { %><strong><%= t('Лимит меньше полного плана; проверка может завершиться по таймауту.') %></strong><% } %>
      </p>
      <% } %>
      <form method="post" action="/admin/settings" class="mt-5 space-y-4">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div>
          <label class="block text-sm font-medium mb-1" for="checkIntervalSeconds"><%= t('Интервал VPN-проверок, секунд') %></label>
          <input id="checkIntervalSeconds" name="checkIntervalSeconds" type="number" min="300" max="86400" step="1" value="<%= checkIntervalSeconds %>" required class="w-full rounded-lg border border-slate-300 px-3 py-2">
          <p class="mt-1 text-xs text-gray-500"><%= t('Минимум 300 секунд (5 минут): чаще запускать проверки нельзя. Например, 3600 — не чаще одного раза в час.') %></p>
        </div>

        <p class="rounded-lg border border-slate-200 bg-slate-50 p-3 text-xs text-gray-600"><%= t('Параллельность и размер очереди применяются сразу после сохранения. Таймауты и интервал источников требуют перезапуска сервиса.') %></p>
        <div>
          <label class="block text-sm font-medium mb-1" for="historyDays"><%= t('Срок хранения статистики подписок, дней') %></label>
          <input id="historyDays" name="historyDays" type="number" min="1" max="365" step="1" value="<%= historyDays %>" required class="w-full rounded-lg border border-slate-300 px-3 py-2">
          <p class="mt-1 text-xs text-gray-500"><%= t('История успешных и неуспешных проверок, задержки и стабильности источников.') %></p>
        </div>
        <div>
          <label class="block text-sm font-medium mb-1" for="probeConcurrency"><%= t('Параллельные VPN-проверки') %></label>
          <input id="probeConcurrency" name="probeConcurrency" type="number" min="1" max="64" step="1" value="<%= probeConcurrency %>" required class="w-full rounded-lg border border-slate-300 px-3 py-2">
          <p class="mt-1 text-xs text-gray-500"><%= t('Количество узлов, проверяемых одновременно.') %></p>
        </div>
        <div>
          <label class="block text-sm font-medium mb-1" for="proxyUrl"><%= t('URL прокси') %></label>
          <input id="proxyUrl" name="proxyUrl" type="text" value="<%= proxyUrl %>" placeholder="http://user:pass@host:port" class="w-full rounded-lg border border-slate-300 px-3 py-2">
          <p class="mt-1 text-xs text-gray-500"><%= t('Поддерживается http:// и https://. Оставьте пустым, чтобы отключить.') %></p>
        </div>
        <div>
          <label class="block text-sm font-medium mb-1" for="proxyMode"><%= t('Режим проверки') %></label>
          <select id="proxyMode" name="proxyMode" class="w-full rounded-lg border border-slate-300 px-3 py-2">
            <option value="disabled" <%= proxyMode === 'disabled' ? 'selected' : '' %>><%= t('Без прокси (выкл.)') %></option>
            <option value="extra" <%= proxyMode === 'extra' ? 'selected' : '' %>><%= t('Дополнительно (extra)') %></option>
            <option value="only" <%= proxyMode === 'only' ? 'selected' : '' %>><%= t('Только через прокси (only)') %></option>
          </select>
        </div>
        <div class="flex flex-wrap items-center gap-3 pt-2">
          <button type="submit" data-icon="save" class="rounded-lg bg-blue-700 px-4 py-2 font-semibold text-white hover:bg-blue-800"><%= t('Сохранить') %></button>
          <button type="button" id="checkProxyBtn" data-icon="check" class="rounded-lg border border-slate-300 px-4 py-2 font-semibold text-slate-700 hover:bg-slate-50"><%= t('Проверить прокси') %></button>
        </div>
      </form>
      <% if (proxyStats.configured) { %>
        <div class="mt-4 flex flex-wrap items-center justify-between gap-3 rounded-lg border border-slate-200 px-3 py-2 text-sm text-slate-600">
<p class="font-medium text-slate-700"><%= t('Доступность узлов через прокси: доступно {healthy} / {total}', { healthy: proxyStats.healthy, total: proxyStats.total }) %></p>
           <p><%= t('Недоступно {failed} · устарело {stale} · Не проверено {unchecked}', { failed: proxyStats.failed, stale: proxyStats.stale, unchecked: proxyStats.unchecked }) %></p>
          <form method="post" action="/admin/settings/recheck">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="text-sm font-semibold text-blue-700 hover:underline"><%= t('Перепроверить') %></button>
          </form>
        </div>
      <% } %>
      <div id="proxyResult" class="mt-4 hidden rounded-lg border p-3 text-sm"></div>
      <div class="mt-6 border-t pt-4">
        <h3 class="text-sm font-semibold text-gray-700"><%= t('Статус Xray') %></h3>
        <p class="mt-1 text-sm text-gray-600"><%= runner.available ? t('Доступен, версия {version}', { version: runner.version }) : runner.error || t('Не проверен') %></p>
      </div>
    </section>
  </main>
  <script>
    document.getElementById('checkProxyBtn').addEventListener('click', async () => {
      const out = document.getElementById('proxyResult');
      out.className = 'mt-4 rounded-lg border p-3 text-sm bg-slate-50 text-slate-700';
      out.textContent = '<%= t('Проверка…') %>';
      out.classList.remove('hidden');
      try {
        const response = await fetch('/api/settings/proxy/check', {
          method: 'POST',
          headers: { 'x-csrf-token': document.querySelector('meta[name="csrf-token"]').content }
        });
        const data = await response.json();
        if (!response.ok) throw new Error(data.error || '<%= t('Ошибка проверки') %>');
        if (data.status === 'healthy') {
          out.className = 'mt-4 rounded-lg border border-green-200 bg-green-50 p-3 text-sm text-green-700';
          out.textContent = `<%= t('Прокси работает. Задержка: {latency} мс', { latency: '{latency}' }) %>`.replace('{latency}', Math.round(data.latencyMs));
        } else {
          out.className = 'mt-4 rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-700';
          out.textContent = `<%= t('Прокси недоступен: {code}') %>`.replace('{code}', data.errorCode || 'unknown');
        }
      } catch (error) {
        out.className = 'mt-4 rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-700';
        out.textContent = error.message;
      }
    });
  </script>
</body>
</html>
