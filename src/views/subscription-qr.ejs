<!DOCTYPE html>
<html lang="<%= locale %>">
<head><%- include('partials/subscription-head', { title: `${t('QR-код подписки')} — ${user.username}` }) %></head>
<body class="min-h-screen bg-slate-950 text-slate-900">
  <main class="flex min-h-screen items-center justify-center px-4 py-8">
    <section class="w-full max-w-md rounded-2xl border border-white/10 bg-white p-6 text-center shadow-2xl sm:p-8">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-blue-700">VPN subscription</p>
      <h1 class="mt-3 break-words text-2xl font-semibold tracking-tight"><%= t('Подписка:') %> <%= user.username %></h1>
      <div class="mx-auto my-6 flex max-w-[320px] items-center justify-center rounded-2xl bg-slate-50 p-3">
        <img src="<%= qrCode %>" alt="<%= t('QR-код ссылки подписки') %>" width="300" height="300" class="max-w-full rounded-lg">
      </div>
      <p class="text-sm leading-6 text-slate-600"><%= t('Отсканируйте код в VPN-клиенте или откройте ссылку подписки.') %></p>
      <a href="<%= subscriptionUrl %>" class="mt-5 inline-flex min-h-[44px] items-center justify-center rounded-lg bg-blue-700 px-4 py-3 font-semibold text-white hover:bg-blue-800"><%= t('Открыть подписку') %></a>
    </section>
  </main>
</body>
</html>
