<%
  const queueSummary = typeof showQueueMetrics !== 'undefined' && showQueueMetrics;
  const queueTotal = Math.max(0, metrics.progress?.total || 0);
  const queueCompleted = Math.max(0, Math.min(metrics.progress?.completed || 0, queueTotal));
  const queuePercent = queueTotal ? Math.floor(queueCompleted / queueTotal * 100) : 0;
%>
<section class="rounded-2xl border border-blue-200 bg-blue-50 p-4 text-blue-950 shadow-sm md:p-5" data-job-region data-job-id="<%= job ? job.id : '' %>" aria-labelledby="background-queue-title">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div class="flex min-w-0 items-start gap-3">
      <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-blue-600 text-white" aria-hidden="true">
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16M4 12h6M4 18h6"/><circle cx="17" cy="15" r="5"/><path d="M17 12v3l2 1"/></svg>
      </div>
      <div class="min-w-0">
        <h2 id="background-queue-title" class="text-lg font-semibold tracking-tight"><%= t('Фоновая очередь') %></h2>
        <p class="mt-1 text-sm leading-5 text-blue-800"><%= t('Загрузка и VPN-проверки выполняются в фоне. Результаты сохраняются после проверки каждого узла.') %></p>
      </div>
    </div>
    <a href="<%= refreshUrl %>" data-job-refresh data-icon="refresh" class="inline-flex min-h-[44px] shrink-0 items-center justify-center rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500"><%= t('Обновить результаты') %></a>
  </div>
  <% if (queueSummary) { %>
    <dl class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm" aria-label="<%= t('Состояние очереди') %>">
      <div class="flex items-baseline gap-2"><dt class="text-blue-800"><%= t('В очереди') %></dt><dd class="text-base font-semibold tabular-nums" data-queue-count><%= metrics.queued %></dd></div>
      <div class="flex items-baseline gap-2"><dt class="text-blue-800"><%= t('Проверяются') %></dt><dd class="text-base font-semibold tabular-nums" data-queue-running><%= metrics.running.check %></dd></div>
      <div class="flex items-baseline gap-2"><dt class="text-blue-800"><%= t('Максимальное ожидание') %></dt><dd class="font-semibold tabular-nums"><span data-queue-wait><%= Math.ceil(metrics.oldest_wait_ms / 60000) %></span> <%= t('мин') %></dd></div>
    </dl>
    <div class="mt-3 border-t border-blue-200 pt-3">
      <div class="flex items-center justify-between gap-3 text-sm">
        <p id="background-queue-progress-label" class="text-blue-800" data-queue-progress-label><%= queueTotal ? t('Обработано задач: {completed} из {total}', { completed: queueCompleted, total: queueTotal }) : t('Очередь пуста') %></p>
        <span class="font-semibold tabular-nums" data-queue-percent><%= queuePercent %>%</span>
      </div>
      <progress class="subscription-progress mt-2 block" data-queue-progress aria-label="<%= t('Прогресс очереди') %>" aria-describedby="background-queue-progress-label" max="<%= queueTotal || 1 %>" value="<%= queueCompleted %>"><%= queuePercent %>%</progress>
    </div>
    <p class="mt-2 hidden text-sm text-amber-800" data-queue-error role="status" aria-live="polite"></p>
  <% } %>
  <div class="mt-3 border-t border-blue-200 pt-3 <%= job ? '' : 'hidden' %>" data-job-details>
    <p class="break-words text-sm font-medium" data-job-message role="status" aria-live="polite" aria-atomic="true"><% if (job) { %><%= statusLabel(job.state) %>: <%= job.completed %> <%= t('из') %> <%= job.total %>. <%= job.error || '' %><% } %></p>
    <% if (!queueSummary) { %>
      <progress class="subscription-progress mt-2 block <%= job && job.total > 0 ? '' : 'hidden' %>" data-job-progress aria-label="<%= t('Прогресс задачи') %>" max="<%= job && job.total > 0 ? job.total : 1 %>" value="<%= job ? Math.max(0, Math.min(job.completed, job.total)) : 0 %>"></progress>
    <% } %>
  </div>
  <p class="mt-3 rounded-xl border border-amber-200 bg-amber-50 p-3 text-sm text-amber-950 <%= metrics.storage_error || metrics.runner?.error ? '' : 'hidden' %>" data-queue-warning role="alert"><% if (metrics.storage_error || metrics.runner?.error) { %><%= metrics.storage_error || metrics.runner.error %> <%= t('Последний успешный VPN-тест действует до истечения срока актуальности.') %><% } %></p>
</section>
