<div class="rounded-xl border border-blue-200 bg-blue-50 p-4 text-blue-950 shadow-sm" data-job-region data-job-id="<%= job ? job.id : '' %>" role="status" aria-live="polite">
  <p data-job-message><% if (job) { %><%= statusLabel(job.state) %>: <%= job.completed %> из <%= job.total %>. <%= job.error || '' %><% } else { %>Загрузка и VPN-проверки выполняются в фоне. Результаты сохраняются после проверки каждого узла.<% } %></p>
  <a href="<%= refreshUrl %>" data-job-refresh class="inline-block mt-2 underline underline-offset-4">Обновить результаты</a>
</div>
<% if (metrics.storage_error || metrics.runner?.error) { %>
  <p class="rounded-xl border border-amber-200 bg-amber-50 p-4 text-amber-950 shadow-sm"><%= metrics.storage_error || metrics.runner.error %> Последний успешный VPN-тест действует до истечения срока актуальности.</p>
<% } %>
