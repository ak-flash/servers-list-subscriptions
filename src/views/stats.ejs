<!DOCTYPE html>
<html lang="ru">

<head><%- include('partials/subscription-head', { title: `Статистика — ${appName}` }) %></head>

<body class="bg-slate-100 text-slate-900">
    <%- include('partials/subscription-header', { heading: 'Статистика' }) %>
    <main id="main" class="mx-auto max-w-6xl px-4 py-6 md:py-8">
        <section class="relative mb-6 overflow-hidden rounded-2xl bg-slate-900 p-5 text-white shadow-xl md:p-8">
            <div class="absolute -right-20 -top-24 h-64 w-64 rounded-full bg-blue-500/20 blur-3xl" aria-hidden="true"></div>
            <div class="relative flex flex-wrap items-end justify-between gap-5">
                <div><p class="text-xs font-semibold uppercase tracking-[0.18em] text-blue-300">Аналитика сервиса</p><h2 class="mt-2 text-2xl font-semibold tracking-tight md:text-3xl">Статистика</h2><p class="mt-2 text-sm text-slate-300">Запросы подписок, пользователи и использование трафика.</p></div>
                <button onclick="clearStatistics()" class="min-h-[44px] rounded-lg border border-red-300/40 bg-red-500/10 px-4 py-3 font-semibold text-red-100 hover:bg-red-500/20">Очистить статистику</button>
            </div>
        </section>
        <div class="stats-card mb-6">
            <div class="flex flex-wrap items-center gap-4 mb-4 pb-4 border-b">
                <h2 class="text-lg font-semibold text-gray-800">Выберите месяц:</h2>
                <form method="GET" action="/admin/stats" class="flex items-center gap-2">
                    <select name="month" onchange="this.form.submit()" class="rounded-lg border border-slate-300 px-3 py-2 focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-100">
                        <option value="">Все время</option>
                        <% if (typeof availableMonths !== 'undefined' && availableMonths.length > 0) { %>
                            <% availableMonths.forEach(function(m) { %>
                                <option value="<%= m %>" <%= selectedMonth === m ? 'selected' : '' %>>
                                    <%= formatDate(m + '-01', { year: 'numeric', month: 'long' }) %>
                                </option>
                            <% }); %>
                        <% } %>
                    </select>
                </form>
                <% if (selectedMonth) { %>
                    <a href="/admin/stats" class="text-sm text-gray-500 hover:text-gray-700">Сбросить</a>
                <% } %>
            </div>
            <h2 class="text-lg font-semibold text-gray-800 mb-4 pb-4 border-b">Общая статистика</h2>
            <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
                <div class="rounded-lg bg-slate-50 p-4"><div class="text-2xl font-bold text-slate-900"><%= totalRequests %></div><div class="text-sm text-slate-500">Запросов</div></div>
                <div class="rounded-lg bg-slate-50 p-4"><div class="text-2xl font-bold text-slate-900"><%= totalUsers %></div><div class="text-sm text-slate-500">Пользователей</div></div>
                <div class="rounded-lg bg-blue-50 p-4"><div class="text-2xl font-bold text-blue-900"><%= formattedThreeXuiTotalTraffic %></div><div class="text-sm text-blue-700">3x-ui трафик</div><div class="mt-1 space-y-0.5 text-xs text-blue-600"><div>Входящий: <%= formattedThreeXuiDownload %></div><div>Исходящий: <%= formattedThreeXuiUpload %></div></div></div>
                <div class="rounded-lg bg-slate-900 p-4"><div class="text-2xl font-bold text-white"><%= formattedTotalTraffic %></div><div class="text-sm text-slate-300">Общий трафик</div><div class="mt-1 space-y-0.5 text-xs text-slate-400"><div>Входящий: <%= formattedTotalDownload %></div><div>Исходящий: <%= formattedTotalUpload %></div></div></div>
            </div>
        </div>

        <section class="stats-card mb-6">
            <div class="flex flex-wrap items-end justify-between gap-3 mb-5 pb-4 border-b">
                <div><p class="text-xs font-semibold uppercase tracking-wider text-blue-600">Контроль использования</p><h2 class="mt-1 text-xl font-semibold text-gray-800">Пользователи, подключения и трафик</h2><p class="mt-1 text-sm text-gray-500">Сводка по назначенным серверам и накопленному трафику каждого пользователя.</p></div>
                <div class="flex gap-2 text-sm"><span class="rounded-lg bg-blue-50 px-3 py-2 font-semibold text-blue-700"><%= topTrafficUsers.length %> пользователей</span><span class="rounded-lg bg-slate-100 px-3 py-2 font-semibold text-slate-700"><%= userConnectionTotal %> подключений</span></div>
            </div>
            <% if (topTrafficUsers.length === 0) { %><p class="py-6 text-center text-gray-500">Нет данных о пользователях</p><% } else { %>
                <div class="overflow-x-auto -mx-4 px-4 md:mx-0 md:px-0"><table class="stats-table"><thead><tr class="border-b text-left text-xs uppercase tracking-wide text-gray-500"><th class="pb-3">Пользователь</th><th class="pb-3">Статус</th><th class="pb-3">Подключения</th><th class="pb-3">Загрузка</th><th class="pb-3">Отдача</th><th class="pb-3">Всего</th><th class="pb-3">Запросов</th></tr></thead><tbody>
                <% topTrafficUsers.forEach(function(user) { %><tr class="border-b last:border-0"><td class="py-3 font-semibold"><%= user.username %><div class="text-xs font-normal text-gray-500"><%= user.last_request ? date(user.last_request) : 'Нет запросов' %></div></td><td class="py-3"><span class="rounded-full px-2 py-1 text-xs font-semibold <%= user.total_traffic > 0 ? 'bg-emerald-100 text-emerald-700' : 'bg-slate-100 text-slate-500' %>"><%= user.total_traffic > 0 ? 'Активен' : 'Нет трафика' %></span></td><td class="py-3 font-medium"><%= user.connection_count || 0 %></td><td class="py-3 text-sm text-blue-600"><%= user.formatted_download %></td><td class="py-3 text-sm text-emerald-600"><%= user.formatted_upload %></td><td class="py-3 font-bold"><%= user.formatted_total %></td><td class="py-3 text-sm text-gray-500"><%= user.request_count || 0 %></td></tr><% }); %>
                </tbody></table></div>
            <% } %>
        </section>

        <div class="stats-card mb-6">
            <h2 class="text-lg font-semibold text-gray-800 mb-4 pb-4 border-b">Подключения 3x-ui по трафику</h2>
            <% if (threeXuiInbounds.length===0) { %>
                <p class="text-gray-500 text-center py-4">Нет данных подключений 3x-ui</p>
                <% } else { %>
                    <div class="overflow-x-auto -mx-4 px-4 md:mx-0 md:px-0"><table class="stats-table">
                        <thead>
                            <tr class="text-left text-gray-600 border-b">
                                <th class="pb-2">#</th>
                                <th class="pb-2">Панель</th>
                                <th class="pb-2">Подключение</th>
                                <th class="pb-2">Тег</th>
                                <th class="pb-2">Протокол</th>
                                <th class="pb-2">Порт</th>
                                <th class="pb-2">Трафик</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% threeXuiInbounds.forEach(function(inbound, index) { %>
                                <tr class="border-b last:border-0">
                                    <td class="py-2 text-gray-500"><%= index + 1 %></td>
                                    <td class="py-2 font-medium"><%= inbound.panel_name %></td>
                                    <td class="py-2"><%= inbound.remark || inbound.inbound_id %></td>
                                    <td class="py-2 text-sm text-gray-500"><%= inbound.tag || '—' %></td>
                                    <td class="py-2 text-sm text-gray-500"><%= inbound.protocol || '—' %></td>
                                    <td class="py-2 text-sm text-gray-500"><%= inbound.port || '—' %></td>
                                    <td class="py-2 text-sm font-medium"><%= inbound.formatted_total %><div class="text-xs font-normal text-gray-500">Исходящий: <%= inbound.formatted_upload %> · Входящий: <%= inbound.formatted_download %></div></td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table></div>
                <% } %>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
            <div class="stats-card">
                <h2 class="text-lg font-semibold text-gray-800 mb-4 pb-4 border-b">Топ пользователей</h2>
                <% if (topUsers.length===0) { %>
                    <p class="text-gray-500 text-center py-4">Нет данных</p>
                    <% } else { %>
                        <div class="overflow-x-auto -mx-4 px-4 md:mx-0 md:px-0"><table class="stats-table">
                            <thead>
                                <tr class="text-left text-gray-600 border-b">
                                    <th class="pb-2">#</th>
                                    <th class="pb-2">Пользователь</th>
                                    <th class="pb-2">Запросов</th>
                                    <th class="pb-2">Последний</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% topUsers.forEach(function(user, index) { %>
                                    <tr class="border-b last:border-0">
                                        <td class="py-2 text-gray-500">
                                            <%= index + 1 %>
                                        </td>
                                        <td class="py-2 font-medium">
                                            <%= user.username %>
                                        </td>
                                        <td class="py-2">
                                            <%= user.request_count %>
                                        </td>
                                        <td class="py-2 text-sm text-gray-500">
<%= user.last_request ? date(user.last_request) : '—' %>
                                        </td>
                                    </tr>
                                    <% }); %>
                            </tbody>
                        </table></div>
                         <% } %>
            </div>

            <div class="stats-card">
                <h2 class="text-lg font-semibold text-gray-800 mb-4 pb-4 border-b">Топ по трафику (серверы)</h2>
                <% if (topServersTraffic.length===0) { %>
                    <p class="text-gray-500 text-center py-4">Нет данных о трафике</p>
                    <% } else { %>
                        <div class="overflow-x-auto -mx-4 px-4 md:mx-0 md:px-0"><table class="stats-table">
                            <thead>
                                <tr class="text-left text-gray-600 border-b">
                                    <th class="pb-2">#</th>
                                    <th class="pb-2">Сервер</th>
                                    <th class="pb-2">Тег</th>
                                    <th class="pb-2">Загрузка</th>
                                    <th class="pb-2">Отдача</th>
                                    <th class="pb-2">Всего</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% topServersTraffic.forEach(function(server, index) { %>
                                    <tr class="border-b last:border-0">
                                        <td class="py-2 text-gray-500">
                                            <%= index + 1 %>
                                        </td>
                                        <td class="py-2 font-medium">
                                            <%= server.name %>
                                        </td>
                                        <td class="py-2 text-sm text-gray-500">
                                            <%= server.tag || '—' %>
                                        </td>
                                        <td class="py-2 text-sm">
                                            <span class="text-blue-600">
                                                <%= server.formatted_download %>
                                            </span>
                                        </td>
                                        <td class="py-2 text-sm">
                                            <span class="text-green-600">
                                                <%= server.formatted_upload %>
                                            </span>
                                        </td>
                                        <td class="py-2 text-sm font-medium">
                                            <%= server.formatted_total %>
                                        </td>
                                    </tr>
                                    <% }); %>
                            </tbody>
                        </table></div>
                         <% } %>
            </div>

            <div class="stats-card">
                <h2 class="text-lg font-semibold text-gray-800 mb-4 pb-4 border-b">Запросов по дням (30 дней)</h2>
                <% if (requestsByDay.length===0) { %>
                    <p class="text-gray-500 text-center py-4">Нет данных</p>
                    <% } else { %>
                        <div class="space-y-2 max-h-80 overflow-y-auto">
                            <% requestsByDay.forEach(function(day) { %>
                                <div class="flex items-center justify-between py-1 border-b border-gray-100">
                                    <span class="text-sm text-gray-600">
                                        <%= date(day.day) %>
                                    </span>
                                    <div class="flex items-center gap-2">
                                        <div class="bg-blue-500 rounded"
                                            style="width: <%= Math.min(day.count * 5, 100) %>px; height: 8px;"></div>
                                        <span class="text-sm font-medium">
                                            <%= day.count %>
                                        </span>
                                    </div>
                                </div>
                                <% }); %>
                        </div>
                        <% } %>
            </div>
        </div>

        <div class="stats-card mb-4">
            <h2 class="text-lg font-semibold text-gray-800 mb-4 pb-4 border-b">Последние запросы</h2>
            <% if (lastRequests.length===0) { %>
                <p class="text-gray-500 text-center py-8">Нет запросов подписок</p>
                <% } else { %>
                    <table class="stats-table hidden md:table">
                        <thead>
                            <tr class="text-left text-gray-600 border-b">
                                <th class="pb-3">ID</th>
                                <th class="pb-3">Пользователь</th>
                                <th class="pb-3">Дата и время</th>
                                <th class="pb-3">IP адрес</th>
                                <th class="pb-3">User Agent</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% lastRequests.forEach(function(req) { %>
                                <tr class="border-b last:border-0">
                                    <td class="py-3 text-sm text-gray-500">
                                        <%= req.id %>
                                    </td>
                                    <td class="py-3 font-medium">
                                        <%= req.username || 'Неизвестен' %>
                                    </td>
                                    <td class="py-3 text-sm">
                                        <%= date(req.requested_at) %>
                                            <%= formatDate(req.requested_at, { timeStyle: 'short' }) %>
                                    </td>
                                    <td class="py-3 text-sm font-mono">
                                        <%= req.ip_address || '—' %>
                                    </td>
                                    <td class="py-3 text-sm text-gray-500 truncate max-w-xs"
                                        title="<%= req.user_agent %>">
                                        <%= req.user_agent ? req.user_agent.substring(0, 50) + '...' : '—' %>
                                    </td>
                                </tr>
                                <% }); %>
                        </tbody>
                    </table>
                    <div class="md:hidden space-y-3">
                        <% lastRequests.forEach(function(req) { %>
                            <div class="border border-gray-200 rounded-lg p-3">
                                <div class="flex justify-between items-start mb-2">
                                    <span class="font-medium">
                                        <%= req.username || 'Неизвестен' %>
                                    </span>
                                    <span class="text-xs text-gray-500">#<%= req.id %></span>
                                </div>
                                <div class="text-sm text-gray-500 mb-1">
                                    <%= date(req.requested_at) %>
                                        <%= formatDate(req.requested_at, { timeStyle: 'short' }) %>
                                </div>
                                <div class="text-xs font-mono text-gray-400 truncate">
                                    <%= req.ip_address || '—' %>
                                </div>
                            </div>
                            <% }); %>
                    </div>
                    <% } %>
        </div>
    </main>

    <script>
        const csrfToken = '<%= csrfToken %>';
        function clearStatistics() {
            if (confirm('Вы уверены, что хотите очистить всю статистику? Это действие нельзя отменить.')) {
                fetch('/admin/stats/clear', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'x-csrf-token': csrfToken,
                    }
                })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            alert(data.message);
                            // Reload the page to show updated statistics
                            window.location.reload();
                        } else {
                            alert('Ошибка: ' + data.message);
                        }
                    })
                    .catch(error => {
                        alert('Ошибка при очистке статистики: ' + error.message);
                    });
            }
        }
    </script>
</body>

</html>