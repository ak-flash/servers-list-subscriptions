<!DOCTYPE html>
<html lang="<%= locale %>">

<head><%- include('partials/subscription-head', { title: `${t('Статистика')} — ${appName}` }) %></head>

<body class="bg-slate-100 text-slate-900">
    <%- include('partials/subscription-header', { heading: t('Статистика') }) %>
    <main id="main" class="mx-auto max-w-6xl px-4 py-6 md:py-8">
        <section class="relative mb-4 overflow-hidden rounded-2xl bg-slate-900 p-4 text-white shadow-xl md:p-5">
            <div class="absolute -right-20 -top-24 h-64 w-64 rounded-full bg-blue-500/20 blur-3xl" aria-hidden="true"></div>
            <div class="relative flex flex-wrap items-end justify-between gap-5">
                <div><p class="text-xs font-semibold uppercase tracking-[0.18em] text-blue-300">Аналитика сервиса</p><h2 class="mt-2 text-2xl font-semibold tracking-tight md:text-3xl">Статистика</h2><p class="mt-2 text-sm text-slate-300">Запросы подписок, пользователи и использование трафика.</p></div>
                <button onclick="clearStatistics()" data-icon="trash" class="min-h-[44px] rounded-lg border border-red-300/40 bg-red-500/10 px-4 py-3 font-semibold text-red-100 hover:bg-red-500/20">Очистить статистику</button>
            </div>
        </section>
        <div class="stats-card mb-6">
            <div class="flex flex-wrap items-center gap-4 mb-4 pb-4 border-b">
                <label for="stats-month" class="text-lg font-semibold text-gray-800">Выберите месяц:</label>
                <form method="GET" action="/admin/stats" class="w-full min-w-0 sm:w-auto">
                    <select id="stats-month" name="month" onchange="this.form.submit()" class="min-h-[44px] w-full rounded-lg border border-slate-300 px-3 py-2 focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-100">
                        <option value="">Все время</option>
                        <% if (typeof availableMonths !== 'undefined' && availableMonths.length > 0) { %>
                            <% availableMonths.forEach(function(m) { %>
                                <option value="<%= m %>" <%= selectedMonth === m ? 'selected' : '' %>>
                                    <%= formatDate(m + '-01', { year: 'numeric', month: 'long' }) %>
                                </option>
                            <% }); %>
                        <% } %>
                    </select>
                </form>
                <% if (selectedMonth) { %>
                    <a href="/admin/stats" class="text-sm text-gray-500 hover:text-gray-700">Сбросить</a>
                <% } %>
            </div>
            <h2 class="text-lg font-semibold text-gray-800 mb-4 pb-4 border-b">Общая статистика</h2>
            <div class="grid grid-cols-2 gap-3 lg:grid-cols-3">
                <div class="rounded-lg bg-slate-50 p-4"><div class="text-2xl font-bold text-slate-900"><%= totalRequests %></div><div class="text-sm text-slate-500">Запросов</div></div>
                <div class="rounded-lg bg-slate-50 p-4"><div class="text-2xl font-bold text-slate-900"><%= totalUsers %></div><div class="text-sm text-slate-500">Пользователей</div></div>
                <div class="col-span-2 rounded-lg bg-slate-900 p-4 lg:col-span-1">
                    <div class="flex items-center justify-between gap-4">
                        <div>
                            <div class="text-2xl font-bold text-white"><%= formattedTotalTraffic %></div>
                            <div class="text-sm text-slate-300">Общий трафик</div>
                        </div>
                        <div class="flex flex-col items-end gap-1 text-xs text-slate-300">
                            <span class="inline-flex items-center gap-1 rounded-full bg-white/10 px-2 py-1 whitespace-nowrap"><span aria-hidden="true">↓</span> <%= formattedTotalDownload %></span>
                            <span class="inline-flex items-center gap-1 rounded-full bg-white/10 px-2 py-1 whitespace-nowrap"><span aria-hidden="true">↑</span> <%= formattedTotalUpload %></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <section class="stats-card mb-6">
            <div class="flex flex-wrap items-end justify-between gap-3 mb-5 pb-4 border-b">
                <div><p class="text-xs font-semibold uppercase tracking-wider text-blue-600">Контроль использования</p><h2 class="mt-1 text-xl font-semibold text-gray-800">Пользователи, подключения и трафик</h2><p class="mt-1 text-sm text-gray-500">Сводка по назначенным серверам и накопленному трафику каждого пользователя.</p></div>
                <div class="flex flex-wrap gap-2 text-sm"><span class="rounded-lg bg-blue-50 px-3 py-2 font-semibold text-blue-700"><%= topTrafficUsers.length %> пользователей</span><span class="rounded-lg bg-slate-100 px-3 py-2 font-semibold text-slate-700"><%= userConnectionTotal %> подключений</span></div>
            </div>
            <% if (topTrafficUsers.length === 0) { %>
                <p class="py-6 text-center text-gray-500">Нет данных о пользователях</p>
            <% } else { %>
                <div class="hidden overflow-x-auto lg:block">
                    <table class="stats-table">
                        <thead><tr><th scope="col">Пользователь</th><th scope="col">Статус</th><th scope="col">Подключения</th><th scope="col">Загрузка</th><th scope="col">Отдача</th><th scope="col">Всего</th><th scope="col">Запросов</th></tr></thead>
                        <tbody>
                            <% topTrafficUsers.forEach(function(user) { %>
                                <tr>
                                    <td class="font-semibold"><%= user.username %><div class="text-xs font-normal text-gray-500"><%= user.last_request ? date(user.last_request) : 'Нет запросов' %></div></td>
                                    <td><span class="whitespace-nowrap rounded-full px-2 py-1 text-xs font-semibold <%= user.total_traffic > 0 ? 'bg-emerald-100 text-emerald-700' : 'bg-slate-100 text-slate-500' %>"><%= user.total_traffic > 0 ? 'Активен' : 'Нет трафика' %></span></td>
                                    <td class="font-medium"><%= user.connection_count || 0 %></td>
                                    <td class="whitespace-nowrap text-sm text-blue-600"><%= user.formatted_download %></td>
                                    <td class="whitespace-nowrap text-sm text-emerald-600"><%= user.formatted_upload %></td>
                                    <td class="whitespace-nowrap font-bold"><%= user.formatted_total %></td>
                                    <td class="text-sm text-gray-500"><%= user.request_count || 0 %></td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
                <ul class="grid min-w-0 gap-3 sm:grid-cols-2 lg:hidden" aria-label="Трафик пользователей">
                    <% topTrafficUsers.forEach(function(user) { %>
                        <li class="min-w-0 rounded-xl border border-slate-200 bg-slate-50 p-4">
                            <div class="flex flex-wrap items-start justify-between gap-2">
                                <h3 class="stats-wrap min-w-0 flex-1 font-semibold"><%= user.username %></h3>
                                <span class="shrink-0 rounded-full px-2 py-1 text-xs font-semibold <%= user.total_traffic > 0 ? 'bg-emerald-100 text-emerald-700' : 'bg-slate-100 text-slate-500' %>"><%= user.total_traffic > 0 ? 'Активен' : 'Нет трафика' %></span>
                            </div>
                            <p class="mt-2 text-xs text-slate-500">Последний запрос: <%= user.last_request ? date(user.last_request) : 'Нет запросов' %></p>
                            <dl class="mt-4 grid grid-cols-2 gap-x-3 gap-y-3 text-sm">
                                <div class="col-span-2 flex flex-wrap items-baseline justify-between gap-2 border-b border-slate-200 pb-3"><dt class="text-slate-500">Всего трафика</dt><dd class="text-xl font-bold tabular-nums"><%= user.formatted_total %></dd></div>
                                <div><dt class="text-xs text-slate-500">Загрузка</dt><dd class="mt-1 font-semibold text-blue-600"><%= user.formatted_download %></dd></div>
                                <div><dt class="text-xs text-slate-500">Отдача</dt><dd class="mt-1 font-semibold text-emerald-600"><%= user.formatted_upload %></dd></div>
                                <div><dt class="text-xs text-slate-500">Подключения</dt><dd class="mt-1 font-semibold"><%= user.connection_count || 0 %></dd></div>
                                <div><dt class="text-xs text-slate-500">Запросов</dt><dd class="mt-1 font-semibold"><%= user.request_count || 0 %></dd></div>
                            </dl>
                        </li>
                    <% }); %>
                </ul>
            <% } %>
        </section>

        <section class="stats-card mb-6">
            <h2 class="text-lg font-semibold text-gray-800 mb-4 pb-4 border-b">Подключения 3x-ui по трафику</h2>
            <% if (threeXuiInbounds.length === 0) { %>
                <p class="text-gray-500 text-center py-4">Нет данных подключений 3x-ui</p>
            <% } else { %>
                <div class="hidden overflow-x-auto lg:block">
                    <table class="stats-table">
                        <thead><tr><th scope="col">#</th><th scope="col">Панель</th><th scope="col">Подключение</th><th scope="col">Тег</th><th scope="col">Протокол</th><th scope="col">Порт</th><th scope="col">Трафик</th></tr></thead>
                        <tbody>
                            <% threeXuiInbounds.forEach(function(inbound, index) { %>
                                <tr>
                                    <td class="text-gray-500"><%= index + 1 %></td>
                                    <td class="font-medium"><%= inbound.panel_name %></td>
                                    <td><%= inbound.remark || inbound.inbound_id %></td>
                                    <td class="text-sm text-gray-500"><%= inbound.tag || '—' %></td>
                                    <td class="text-sm text-gray-500"><%= inbound.protocol || '—' %></td>
                                    <td class="text-sm text-gray-500"><%= inbound.port || '—' %></td>
                                    <td class="whitespace-nowrap text-sm font-medium"><%= inbound.formatted_total %><div class="text-xs font-normal text-gray-500">↑ <%= inbound.formatted_upload %> · ↓ <%= inbound.formatted_download %></div></td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
                <ul class="grid min-w-0 gap-3 sm:grid-cols-2 lg:hidden" aria-label="Трафик подключений 3x-ui">
                    <% threeXuiInbounds.forEach(function(inbound, index) { %>
                        <li class="min-w-0 rounded-xl border border-slate-200 bg-slate-50 p-4">
                            <div class="flex items-start gap-3">
                                <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-blue-50 text-sm font-semibold text-blue-700"><%= index + 1 %></span>
                                <h3 class="stats-wrap min-w-0 font-semibold"><%= inbound.remark || inbound.inbound_id %></h3>
                            </div>
                            <dl class="mt-3 grid grid-cols-2 gap-3 text-sm">
                                <div class="col-span-2 min-w-0"><dt class="text-xs text-slate-500">Панель</dt><dd class="stats-wrap mt-1 font-medium"><%= inbound.panel_name %></dd></div>
                                <div class="col-span-2 min-w-0"><dt class="text-xs text-slate-500">Тег</dt><dd class="stats-wrap mt-1 font-mono text-xs"><%= inbound.tag || '—' %></dd></div>
                                <div><dt class="text-xs text-slate-500">Протокол</dt><dd class="stats-wrap mt-1 font-medium"><%= inbound.protocol || '—' %></dd></div>
                                <div><dt class="text-xs text-slate-500">Порт</dt><dd class="mt-1 font-medium"><%= inbound.port || '—' %></dd></div>
                                <div class="col-span-2 flex flex-wrap items-baseline justify-between gap-2 border-t border-slate-200 pt-3"><dt class="text-slate-500">Всего трафика</dt><dd class="text-xl font-bold tabular-nums"><%= inbound.formatted_total %></dd></div>
                                <div><dt class="text-xs text-slate-500">Загрузка</dt><dd class="mt-1 font-semibold text-blue-600"><%= inbound.formatted_download %></dd></div>
                                <div><dt class="text-xs text-slate-500">Отдача</dt><dd class="mt-1 font-semibold text-emerald-600"><%= inbound.formatted_upload %></dd></div>
                            </dl>
                        </li>
                    <% }); %>
                </ul>
            <% } %>
        </section>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
            <section class="stats-card">
                <h2 class="text-lg font-semibold text-gray-800 mb-4 pb-4 border-b">Топ пользователей</h2>
                <% if (topUsers.length === 0) { %>
                    <p class="text-gray-500 text-center py-4">Нет данных</p>
                <% } else { %>
                    <div class="hidden overflow-x-auto lg:block">
                        <table class="stats-table">
                            <thead><tr><th scope="col">#</th><th scope="col">Пользователь</th><th scope="col">Запросов</th><th scope="col">Последний</th></tr></thead>
                            <tbody>
                                <% topUsers.forEach(function(user, index) { %>
                                    <tr>
                                        <td class="text-gray-500"><%= index + 1 %></td>
                                        <td class="font-medium"><%= user.username || 'Удалён' %></td>
                                        <td><%= user.request_count %></td>
                                        <td class="text-sm text-gray-500"><%= user.last_request ? date(user.last_request) : '—' %></td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                    <ol class="space-y-3 lg:hidden" aria-label="Пользователи по числу запросов">
                        <% topUsers.forEach(function(user, index) { %>
                            <li class="flex min-w-0 items-start gap-3 rounded-xl border border-slate-200 bg-slate-50 p-3">
                                <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-blue-50 text-sm font-semibold text-blue-700"><%= index + 1 %></span>
                                <div class="min-w-0 flex-1">
                                    <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
                                        <span class="stats-wrap min-w-0 flex-1 font-semibold"><%= user.username || 'Удалён' %></span>
                                        <span class="whitespace-nowrap text-sm text-blue-600"><strong><%= user.request_count %></strong> запросов</span>
                                    </div>
                                    <p class="mt-1 text-xs text-slate-500">Последний: <%= user.last_request ? date(user.last_request) : '—' %></p>
                                </div>
                            </li>
                        <% }); %>
                    </ol>
                <% } %>
            </section>

            <div class="stats-card">
                <h2 class="text-lg font-semibold text-gray-800 mb-4 pb-4 border-b">Запросов по дням (30 дней)</h2>
                <% if (requestsByDay.length===0) { %>
                    <p class="text-gray-500 text-center py-4">Нет данных</p>
                    <% } else { %>
                        <div class="space-y-2 max-h-80 overflow-y-auto">
                            <% requestsByDay.forEach(function(day) { %>
                                <div class="flex items-center justify-between py-1 border-b border-gray-100">
                                    <span class="text-sm text-gray-600">
                                        <%= date(day.day) %>
                                    </span>
                                    <div class="flex items-center gap-2">
                                        <div class="bg-blue-500 rounded"
                                            style="width: <%= Math.min(day.count * 5, 100) %>px; height: 8px;"></div>
                                        <span class="text-sm font-medium">
                                            <%= day.count %>
                                        </span>
                                    </div>
                                </div>
                                <% }); %>
                        </div>
                        <% } %>
            </div>
        </div>

        <section id="requests" class="stats-card mb-4 scroll-mt-6" aria-labelledby="requests-heading">
            <div class="mb-4 flex flex-wrap items-baseline justify-between gap-2 border-b pb-4">
                <h2 id="requests-heading" class="text-lg font-semibold text-gray-800">Последние запросы</h2>
                <p class="text-xs text-slate-500">По <%= requestPagination.perPage %> на странице</p>
            </div>
            <% if (lastRequests.length === 0) { %>
                <p class="text-gray-500 text-center py-8">Нет запросов подписок</p>
            <% } else { %>
                <div class="hidden overflow-x-auto lg:block">
                    <table class="stats-table table-fixed">
                        <thead><tr><th scope="col" class="w-16">ID</th><th scope="col" class="w-1/5">Пользователь</th><th scope="col" class="w-1/5">Дата и время</th><th scope="col" class="w-1/5">IP адрес</th><th scope="col">User Agent</th></tr></thead>
                        <tbody>
                            <% lastRequests.forEach(function(req) { %>
                                <tr data-request-id="<%= req.id %>">
                                    <td class="text-sm text-slate-500"><%= req.id %></td>
                                    <td class="font-medium"><%= req.username || 'Неизвестен' %></td>
                                    <td class="text-sm"><%= date(req.requested_at) %><div class="mt-1 text-xs text-slate-500"><%= formatDate(req.requested_at, { timeStyle: 'short' }) %></div></td>
                                    <td class="font-mono text-xs"><%= req.ip_address || '—' %></td>
                                    <td class="text-sm text-gray-500">
                                        <% if (req.user_agent) { %>
                                            <details class="group">
                                                <summary class="stats-wrap min-h-[44px] cursor-pointer rounded-lg py-2 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600"><span class="group-open:hidden"><%= req.user_agent.length > 60 ? req.user_agent.slice(0, 60) + '…' : req.user_agent %></span><span class="hidden group-open:inline">Скрыть User Agent</span></summary>
                                                <p class="stats-wrap pb-2"><%= req.user_agent %></p>
                                            </details>
                                        <% } else { %>—<% } %>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
                <ul class="grid min-w-0 gap-3 sm:grid-cols-2 lg:hidden" aria-label="Последние запросы">
                    <% lastRequests.forEach(function(req) { %>
                        <li class="min-w-0 rounded-xl border border-slate-200 bg-slate-50 p-4" data-request-id="<%= req.id %>">
                            <div class="flex items-start justify-between gap-3">
                                <h3 class="stats-wrap min-w-0 font-semibold"><%= req.username || 'Неизвестен' %></h3>
                                <span class="shrink-0 text-xs text-slate-500">#<%= req.id %></span>
                            </div>
                            <dl class="mt-3 space-y-2 text-sm">
                                <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1"><dt class="text-xs text-slate-500">Дата и время</dt><dd class="text-xs"><%= date(req.requested_at) %> <%= formatDate(req.requested_at, { timeStyle: 'short' }) %></dd></div>
                                <div><dt class="text-xs text-slate-500">IP адрес</dt><dd class="stats-wrap mt-1 select-all font-mono text-xs"><%= req.ip_address || '—' %></dd></div>
                            </dl>
                            <% if (req.user_agent) { %>
                                <details class="mt-3 border-t border-slate-200 pt-1 text-xs text-slate-500">
                                    <summary class="min-h-[44px] cursor-pointer rounded-lg py-3 font-semibold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600">User Agent</summary>
                                    <p class="stats-wrap pb-1"><%= req.user_agent %></p>
                                </details>
                            <% } %>
                        </li>
                    <% }); %>
                </ul>
            <% } %>
            <nav class="mt-4 border-t border-slate-200 pt-4" aria-label="Пагинация запросов" data-pagination="requests">
                <div class="flex flex-wrap items-center justify-between gap-2 text-xs text-slate-500 sm:text-sm">
                    <p data-pagination-info="requests" aria-live="polite">Показаны <%= requestPagination.from %>–<%= requestPagination.to %> из <%= requestPagination.total %> запросов</p>
                    <p>Страница <%= requestPagination.page %> из <%= requestPagination.totalPages %></p>
                </div>
                <% if (requestPagination.totalPages > 1) { %>
                    <div class="mt-3 flex flex-wrap items-center justify-between gap-3">
                        <% if (requestPagination.page > 1) { %>
                            <a rel="prev" class="inline-flex min-h-[44px] items-center justify-center rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600" href="<%= requestPageUrl(requestPagination.page - 1) %>">Назад</a>
                        <% } else { %>
                            <span class="inline-flex min-h-[44px] cursor-not-allowed items-center justify-center rounded-lg border border-slate-200 px-4 py-2 text-sm font-medium text-slate-400" aria-disabled="true">Назад</span>
                        <% } %>
                        <div class="order-last flex w-full flex-wrap justify-center gap-1 sm:order-none sm:w-auto" data-page-numbers="requests">
                            <% requestPagination.pages.forEach(page => { %>
                                <% if (typeof page === 'number') { %>
                                    <a class="inline-flex min-h-[44px] min-w-[44px] items-center justify-center rounded-lg px-3 py-2 text-sm font-medium focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 <%= page === requestPagination.page ? 'bg-blue-700 text-white' : 'border border-slate-300 text-slate-700 hover:bg-slate-50' %>" href="<%= requestPageUrl(page) %>" aria-label="Страница <%= page %>" <%- page === requestPagination.page ? 'aria-current="page"' : '' %>><%= page %></a>
                                <% } else { %>
                                    <span class="inline-flex min-h-[44px] items-center px-1 text-slate-400" aria-hidden="true">…</span>
                                <% } %>
                            <% }); %>
                        </div>
                        <% if (requestPagination.page < requestPagination.totalPages) { %>
                            <a rel="next" class="inline-flex min-h-[44px] items-center justify-center rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600" href="<%= requestPageUrl(requestPagination.page + 1) %>">Вперёд</a>
                        <% } else { %>
                            <span class="inline-flex min-h-[44px] cursor-not-allowed items-center justify-center rounded-lg border border-slate-200 px-4 py-2 text-sm font-medium text-slate-400" aria-disabled="true">Вперёд</span>
                        <% } %>
                    </div>
                <% } %>
            </nav>
        </section>
    </main>

    <script>
        const csrfToken = '<%= csrfToken %>';
        async function clearStatistics() {
            const ok = await uiConfirm({
title: '<%= t('Очистить статистику') %>',
                 message: '<%= t('Все данные о запросах будут удалены. Действие нельзя отменить.') %>',
                 confirmText: '<%= t('Очистить') %>',
                danger: true,
            });
            if (!ok) return;
            try {
                const response = await fetch('/admin/stats/clear', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'x-csrf-token': csrfToken,
                    }
                });
                const data = await response.json();
                if (data.success) {
                    uiToast(data.message || 'Статистика очищена', 'success');
                    setTimeout(() => window.location.reload(), 700);
                } else {
                    uiToast('Ошибка: ' + (data.message || ''), 'error');
                }
            } catch (error) {
                uiToast('Ошибка при очистке статистики', 'error');
            }
        }
    </script>
</body>

</html>