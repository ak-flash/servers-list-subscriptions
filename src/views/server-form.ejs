<!DOCTYPE html>
<html lang="<%= locale %>">
<head><%- include('partials/subscription-head', { title: `${t(server ? 'Редактирование' : 'Добавление')} ${t('сервера')} — ${appName}` }) %></head>
<body class="bg-slate-100 text-slate-900">
    <%- include('partials/subscription-header', { heading: `${t(server ? 'Редактирование' : 'Добавление')} ${t('сервера')}` }) %>
    <main id="main" class="mx-auto max-w-6xl px-4 py-6 md:py-8">
        <section class="mb-6 rounded-2xl bg-slate-900 p-6 text-white shadow-xl">
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-blue-300"><%= t('Ручной каталог') %></p>
            <h2 class="mt-2 text-2xl font-semibold"><%= t(server ? 'Обновите параметры сервера' : 'Добавьте сервер вручную') %></h2>
            <p class="mt-2 max-w-xl text-sm leading-6 text-slate-300"><%= t('Ссылка подключения будет использоваться в персональных подписках пользователей.') %></p>
        </section>
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm md:p-7">
            <% if (error) { %>
                    <div role="alert" class="mb-5 rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-800"><%= error %></div>
            <% } %>

            <form method="POST" action="/admin/servers<%= server ? '/' + server.id : '' %>">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="mb-4">
                    <label class="mb-2 block text-sm font-semibold text-slate-700" for="server-name">Название</label>
                    <input id="server-name" type="text" name="name" value="<%= server ? server.name : '' %>" placeholder="Например, Германия — основной" class="w-full rounded-lg border border-slate-300 px-4 py-3 focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-100">
                </div>

                <% if (!server) { %>
                <div class="mb-4">
                    <label class="mb-2 block text-sm font-semibold text-slate-700" for="server-link">Ссылка подключения</label>
                    <textarea id="server-link" name="link" rows="4" placeholder="vless://..." class="w-full rounded-lg border border-slate-300 px-4 py-3 font-mono text-sm focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-100"><%= server ? server.link : '' %></textarea>
                </div>
                <% } else { %>
                <div class="mb-4">
                    <label class="mb-2 block text-sm font-semibold text-slate-700" for="server-link">Ссылка подключения</label>
                    <textarea id="server-link" name="link" rows="4" placeholder="vless://..." class="w-full rounded-lg border border-slate-300 px-4 py-3 font-mono text-sm focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-100"><%= server ? server.link : '' %></textarea>
                </div>

                <div class="mb-4">
                    <label class="mb-2 block text-sm font-semibold text-slate-700" for="server-tag">Тег подключения <span class="font-normal text-slate-500">(необязательно)</span></label>
                    <input id="server-tag" type="text" name="tag" value="<%= server ? (server.tag || '') : '' %>" placeholder="inbound-8443" class="w-full rounded-lg border border-slate-300 px-4 py-3 font-mono text-sm focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-100">
                </div>

                <div class="mb-4">
                    <label class="mb-2 block text-sm font-semibold text-slate-700" for="traffic-limit">Лимит трафика <span class="font-normal text-slate-500">(ГБ, 0 — без лимита)</span></label>
                    <input id="traffic-limit" type="number" name="traffic_limit" value="<%= server ? (server.traffic_limit || 0) : 0 %>" placeholder="0" min="0" class="w-full rounded-lg border border-slate-300 px-4 py-3 focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-100">
                </div>
                <% } %>

                <div class="mb-6">
                    <label class="flex items-center gap-2">
                        <input type="checkbox" name="is_active" id="is_active" value="1" <%= (!server || server.is_active) ? 'checked' : '' %> class="h-5 w-5 rounded border-slate-300 text-blue-700 focus:ring-blue-600">
                        <span class="text-sm font-medium text-slate-700"><%= t('Сервер активен') %></span>
                    </label>
                </div>

                <div class="flex flex-wrap gap-3 border-t border-slate-100 pt-5">
                    <button type="submit" data-icon="save" class="min-h-[44px] rounded-lg bg-blue-700 px-5 py-3 font-semibold text-white hover:bg-blue-800"><%= t(server ? 'Сохранить сервер' : 'Создать сервер') %></button>
                    <a href="/admin" class="inline-flex min-h-[44px] items-center rounded-lg border border-slate-300 px-5 py-3 font-semibold text-slate-700 hover:bg-slate-50"><%= t('Отмена') %></a>
                </div>
            </form>
        </div>
    </main>
</body>
</html>
