<!DOCTYPE html>
<html lang="ru">
<head><%- include('partials/subscription-head', { title: `Источники подписок — ${appName}` }) %></head>
<body class="bg-slate-100 text-slate-900">
  <%- include('partials/subscription-header', { heading: 'Источники подписок' }) %>
  <% const totalNodes = sources.reduce((sum, source) => sum + source.count, 0); %>
  <% const totalHealthy = sources.reduce((sum, source) => sum + source.healthy, 0); %>
  <% const totalUsers = sources.reduce((sum, source) => sum + source.users, 0); %>
  <main id="main" class="mx-auto max-w-6xl px-4 py-6 md:py-8">
    <section class="relative overflow-hidden rounded-2xl bg-slate-900 text-white shadow-xl mb-6">
      <div class="absolute -right-20 -top-24 h-64 w-64 rounded-full bg-blue-500/20 blur-3xl" aria-hidden="true"></div>
      <div class="relative p-5 md:p-8">
        <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6">
          <div class="max-w-2xl">
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-blue-300">Каталог VPN-узлов</p>
            <h2 class="mt-2 text-2xl md:text-3xl font-semibold tracking-tight">Источники подписок</h2>
            <p class="mt-3 max-w-xl text-sm md:text-base leading-6 text-slate-300">Импортируйте VLESS-подписки, проверяйте реальные подключения через Xray и выдавайте пользователям только рабочие узлы.</p>
          </div>
          <a href="/admin/subscription-sources/new" data-icon="add" class="inline-flex items-center justify-center rounded-lg bg-blue-500 px-4 py-3 font-semibold text-white shadow-sm hover:bg-blue-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-300 min-h-[44px]">Добавить источник</a>
        </div>
        <div class="mt-7 grid grid-cols-2 md:grid-cols-4 gap-3" aria-label="Сводка по источникам">
          <div class="rounded-xl border border-white/10 bg-white/10 p-3"><p class="text-xs text-slate-300">Источники</p><p class="mt-1 text-2xl font-semibold tabular-nums"><%= sources.length %></p></div>
          <div class="rounded-xl border border-white/10 bg-white/10 p-3"><p class="text-xs text-slate-300">Рабочие узлы</p><p class="mt-1 text-2xl font-semibold tabular-nums"><%= totalHealthy %></p></div>
          <div class="rounded-xl border border-white/10 bg-white/10 p-3"><p class="text-xs text-slate-300">В каталоге</p><p class="mt-1 text-2xl font-semibold tabular-nums"><%= totalNodes %></p></div>
          <div class="rounded-xl border border-white/10 bg-white/10 p-3"><p class="text-xs text-slate-300">Привязки</p><p class="mt-1 text-2xl font-semibold tabular-nums"><%= totalUsers %></p></div>
        </div>
      </div>
    </section>

    <section class="mb-6 rounded-xl border border-slate-200 bg-white px-4 py-3 shadow-sm" aria-label="Состояние очереди">
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
        <span class="font-semibold text-slate-800">Фоновая очередь</span>
        <span class="text-slate-600"><strong class="text-slate-900 tabular-nums"><%= metrics.queued %></strong> в очереди</span>
        <span class="text-slate-600"><strong class="text-slate-900 tabular-nums"><%= metrics.running.check %></strong> проверяются</span>
        <span class="text-slate-600">Ожидание: <strong class="text-slate-900 tabular-nums"><%= Math.ceil(metrics.oldest_wait_ms / 60000) %> мин</strong></span>
      </div>
    </section>

    <div class="mb-6"><%- include('partials/subscription-job', { job, metrics, refreshUrl: '/admin/subscription-sources' }) %></div>

    <% if (!sources.length) { %>
      <section class="rounded-2xl border border-dashed border-slate-300 bg-white p-8 text-center shadow-sm">
        <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-blue-50 text-blue-700" aria-hidden="true">+</div>
        <h2 class="mt-4 text-xl font-semibold">Добавьте первый источник</h2>
        <p class="mx-auto mt-2 max-w-md text-sm leading-6 text-slate-600">Укажите HTTP(S)-ссылку на список VLESS-серверов. После проверки источник можно привязать к пользователям.</p>
        <a href="/admin/subscription-sources/new" class="mt-5 inline-flex min-h-[44px] items-center justify-center rounded-lg bg-blue-700 px-4 py-3 font-semibold text-white hover:bg-blue-800">Добавить источник</a>
      </section>
    <% } else { %>
      <div class="mb-4 flex flex-wrap items-end justify-between gap-3">
        <div><h2 class="text-xl font-semibold tracking-tight">Ваши источники</h2><p class="mt-1 text-sm text-slate-600">Состояние обновляется после завершения фоновых задач.</p></div>
        <span class="rounded-full bg-slate-200 px-3 py-1 text-sm font-medium text-slate-700"><%= sources.length %> <%= sources.length === 1 ? 'источник' : 'источника' %></span>
      </div>
      <div class="grid gap-4 lg:grid-cols-2">
        <% sources.forEach(source => { %>
          <article class="group flex h-full min-w-0 flex-col rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition-shadow hover:shadow-md">
            <div class="flex items-start justify-between gap-4">
              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="h-2.5 w-2.5 rounded-full <%= source.is_active ? (source.healthy ? 'bg-emerald-500' : 'bg-amber-400') : 'bg-slate-400' %>" aria-hidden="true"></span>
                  <h3 class="min-w-0 break-words text-lg font-semibold"><a href="/admin/subscription-sources/<%= source.id %>/nodes" class="underline decoration-transparent underline-offset-4 transition hover:decoration-current focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600"><%= source.name %></a></h3>
                </div>
                <p class="mt-2 truncate text-sm text-slate-500" title="<%= source.masked_url %>"><%= source.masked_url %></p>
              </div>
              <a href="/admin/subscription-sources/<%= source.id %>/edit" class="shrink-0 rounded-lg p-2 text-sm font-medium text-slate-500 hover:bg-slate-100 hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-blue-600" aria-label="Настроить источник: <%= source.name %>">Настроить</a>
            </div>
            <div class="mt-5 grid grid-cols-3 divide-x divide-slate-200 rounded-xl bg-slate-50 py-3">
              <div class="px-3"><p class="text-xs text-slate-500">Рабочие</p><p class="mt-1 text-xl font-semibold tabular-nums text-emerald-700"><%= source.healthy %></p></div>
              <div class="px-3"><p class="text-xs text-slate-500">В каталоге</p><p class="mt-1 text-xl font-semibold tabular-nums"><%= source.count %></p></div>
              <div class="px-3"><p class="text-xs text-slate-500">Пользователи</p><p class="mt-1 text-xl font-semibold tabular-nums"><%= source.users %></p></div>
            </div>
            <div class="mt-4 flex flex-wrap items-center gap-2 text-sm">
              <span class="rounded-full px-2.5 py-1 font-medium <%= !source.is_active ? 'bg-slate-100 text-slate-600' : source.sync_status === 'error' ? 'bg-red-50 text-red-700' : source.sync_status === 'running' ? 'bg-blue-50 text-blue-700' : 'bg-emerald-50 text-emerald-700' %>"><%= source.is_active ? statusLabel(source.sync_status) : 'Источник отключён' %></span>
              <span class="text-slate-500">Обновлено: <%= time(source.last_success_at) %></span>
            </div>
            <% if (source.last_error) { %><p class="mt-3 break-words rounded-lg bg-red-50 px-3 py-2 text-sm leading-5 text-red-800" role="alert"><%= source.last_error %></p><% } %>
            <div class="mt-5 flex flex-wrap gap-2 border-t border-slate-100 pt-4">
              <a href="/admin/subscription-sources/<%= source.id %>/nodes" class="inline-flex min-h-[40px] items-center justify-center rounded-lg bg-slate-900 px-3 py-2 text-sm font-semibold text-white hover:bg-slate-700">Открыть узлы</a>
              <% if (source.is_active) { %>
                <form method="post" action="/api/subscription-sources/<%= source.id %>/sync" data-background-action><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button data-icon="download" class="inline-flex min-h-[40px] items-center justify-center rounded-lg border border-slate-300 px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50" aria-label="Загрузить список: <%= source.name %>">Загрузить</button></form>
                <form method="post" action="/api/subscription-sources/<%= source.id %>/check" data-background-action><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button data-icon="check" class="inline-flex min-h-[40px] items-center justify-center rounded-lg border border-blue-200 bg-blue-50 px-3 py-2 text-sm font-semibold text-blue-800 hover:bg-blue-100" aria-label="Проверить VPN: <%= source.name %>">Проверить VPN</button></form>
              <% } %>
            </div>
          </article>
        <% }); %>
      </div>
    <% } %>
  </main>
  <script src="/subscription-actions.js" defer></script>
</body>
</html>
