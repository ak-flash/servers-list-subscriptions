<!DOCTYPE html>
<html lang="ru">
<head><%- include('partials/subscription-head', { title: `3x-ui панели — ${appName}` }) %></head>
<body class="bg-slate-100 text-slate-900">
  <%- include('partials/subscription-header', { heading: '3x-ui панели' }) %>
  <main id="main" class="mx-auto max-w-6xl px-4 py-6 md:py-8">
    <section class="relative mb-6 overflow-hidden rounded-2xl bg-slate-900 p-5 text-white shadow-xl md:p-8">
      <div class="absolute -right-20 -top-24 h-64 w-64 rounded-full bg-blue-500/20 blur-3xl" aria-hidden="true"></div>
      <div class="relative flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-blue-300">3x-ui API</p>
          <h2 class="mt-2 text-2xl font-semibold tracking-tight md:text-3xl">Панели и синхронизация трафика</h2>
          <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-300">Добавьте API-токены панелей 3x-ui, чтобы регулярно получать трафик пользователей и общий трафик inbound-подключений.</p>
        </div>
        <div class="flex flex-wrap gap-2">
          <button type="button" id="syncAll" class="inline-flex min-h-[44px] items-center rounded-lg bg-blue-700 px-4 py-3 font-semibold text-white hover:bg-blue-800">Синхронизировать все</button>
          <a href="/admin/threexui/new" class="inline-flex min-h-[44px] items-center rounded-lg border border-white/20 px-4 py-3 font-semibold text-white hover:bg-white/10">Добавить панель</a>
        </div>
      </div>
    </section>

    <% if (saved) { %>
      <p role="status" class="mb-6 rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-emerald-800">Настройки 3x-ui сохранены.</p>
    <% } %>

    <section class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm md:p-6">
      <% if (!panels.length) { %>
        <p class="py-8 text-center text-slate-500">Панели 3x-ui не настроены.</p>
      <% } else { %>
        <div class="overflow-x-auto">
          <table class="w-full min-w-[820px]">
            <thead>
              <tr class="border-b text-left text-slate-600">
                <th class="pb-3 pr-4">Панель</th>
                <th class="pb-3 pr-4">Статус</th>
                <th class="pb-3 pr-4">Интервал</th>
                <th class="pb-3 pr-4">Последняя синхронизация</th>
                <th class="pb-3 text-right">Действия</th>
              </tr>
            </thead>
            <tbody>
              <% panels.forEach(function(panel) { %>
                <tr class="border-b last:border-0">
                  <td class="py-3 pr-4">
                    <div class="font-semibold text-slate-900"><%= panel.name %></div>
                    <div class="mt-1 text-sm text-slate-500"><%= panel.baseUrl %></div>
                  </td>
                  <td class="py-3 pr-4">
                    <span class="rounded-full px-2.5 py-1 text-xs font-semibold <%= panel.isActive ? 'bg-emerald-100 text-emerald-800' : 'bg-slate-100 text-slate-600' %>">
                      <%= panel.isActive ? 'Активна' : 'Отключена' %>
                    </span>
                    <% if (panel.lastSyncError) { %>
                      <div class="mt-2 max-w-sm text-xs text-red-700"><%= panel.lastSyncError %></div>
                    <% } %>
                  </td>
                  <td class="py-3 pr-4"><%= panel.syncIntervalSeconds %> с</td>
                  <td class="py-3 pr-4"><%= panel.lastSyncAt ? date(panel.lastSyncAt) : 'Никогда' %></td>
                  <td class="py-3">
                    <div class="flex flex-wrap justify-end gap-2">
                      <button type="button" data-sync-panel="<%= panel.id %>" class="inline-flex min-h-[38px] items-center rounded-lg bg-blue-700 px-3 py-1.5 text-sm font-semibold text-white hover:bg-blue-800">Синхронизировать</button>
                      <a href="/admin/threexui/<%= panel.id %>/edit" class="inline-flex min-h-[38px] items-center rounded-lg bg-slate-600 px-3 py-1.5 text-sm font-semibold text-white hover:bg-slate-700">Редактировать</a>
                      <form method="POST" action="/admin/threexui/<%= panel.id %>/delete" onsubmit="return confirm('Удалить панель и её статистику?')">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="inline-flex min-h-[38px] items-center rounded-lg bg-red-700 px-3 py-1.5 text-sm font-semibold text-white hover:bg-red-800">Удалить</button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>
  </main>

  <script>
    const csrfToken = '<%= csrfToken %>';
    const syncAll = document.getElementById('syncAll');
    const syncButtons = [...document.querySelectorAll('[data-sync-panel]')];

    async function sync(url) {
      const response = await fetch(url, { method: 'POST', headers: { 'x-csrf-token': csrfToken } });
      const data = await response.json().catch(() => ({}));
      if (!response.ok && response.status !== 207) throw new Error(data.error || 'Синхронизация завершилась с ошибкой.');
      return data;
    }

    syncAll?.addEventListener('click', async () => {
      syncAll.disabled = true;
      syncAll.textContent = 'Синхронизация…';
      try {
        await sync('/api/threexui/sync');
        window.location.reload();
      } catch (error) {
        alert(error.message);
        syncAll.disabled = false;
        syncAll.textContent = 'Синхронизировать все';
      }
    });

    syncButtons.forEach(button => button.addEventListener('click', async () => {
      button.disabled = true;
      button.textContent = 'Синхронизация…';
      try {
        await sync(`/api/threexui/${button.dataset.syncPanel}/sync`);
        window.location.reload();
      } catch (error) {
        alert(error.message);
        button.disabled = false;
        button.textContent = 'Синхронизировать';
      }
    }));
  </script>
</body>
</html>
