<!DOCTYPE html>
<html lang="<%= locale %>">
<head><%- include('partials/subscription-head', { title: `3x-ui — ${appName}` }) %></head>
<body class="bg-slate-100 text-slate-900">
  <%- include('partials/subscription-header', { heading: '3x-ui' }) %>
  <main id="main" class="mx-auto max-w-6xl px-4 py-6 md:py-8">
    <section class="relative mb-6 overflow-hidden rounded-2xl bg-slate-900 p-4 text-white shadow-xl md:p-6">
      <div class="absolute -right-20 -top-24 h-64 w-64 rounded-full bg-blue-500/20 blur-3xl" aria-hidden="true"></div>
      <div class="relative flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
        <div class="min-w-0">
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-blue-300">3x-ui API</p>
<h2 class="mt-1 text-xl font-semibold tracking-tight md:text-2xl"><%= t('Панели и синхронизация трафика') %></h2>
           <p class="mt-2 max-w-xl text-sm leading-5 text-slate-300"><%= t('Добавьте API-токены панелей 3x-ui, чтобы регулярно получать трафик пользователей и общий трафик inbound-подключений.') %></p>
        </div>
        <div class="flex w-full flex-col gap-2 sm:w-auto sm:flex-row sm:flex-wrap sm:justify-end">
<button type="button" id="syncAll" data-icon="refresh" class="inline-flex min-h-[38px] items-center justify-center rounded-lg bg-blue-700 px-3 py-2 text-sm font-semibold text-white hover:bg-blue-800"><%= t('Синхронизировать все') %></button>
           <a href="/admin/threexui/new" class="inline-flex min-h-[38px] items-center justify-center rounded-lg border border-white/20 px-3 py-2 text-sm font-semibold text-white hover:bg-white/10"><%= t('Добавить панель') %></a>
        </div>
      </div>
    </section>

    <% if (saved) { %>
      <p role="status" class="mb-6 rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-emerald-800"><%= t('Настройки 3x-ui сохранены.') %></p>
    <% } %>

    <section class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm md:p-6">
      <% if (!panels.length) { %>
        <p class="py-8 text-center text-slate-500"><%= t('Панели 3x-ui не настроены.') %></p>
      <% } else { %>
        <div class="overflow-x-auto">
          <table class="w-full min-w-[860px] table-fixed">
            <thead>
              <tr class="border-b text-left text-xs font-semibold uppercase tracking-[0.08em] text-slate-500">
                <th class="w-[26%] pb-3 pr-4"><%= t('Панель') %></th>
                <th class="w-[24%] pb-3 pr-4"><%= t('Статус') %></th>
                <th class="w-[16%] pb-3 pr-4"><%= t('Интервал') %></th>
                <th class="w-[18%] pb-3 pr-4"><%= t('Последняя синхронизация') %></th>
                <th class="w-[16%] pb-3 text-right"><%= t('Действия') %></th>
              </tr>
            </thead>
            <tbody>
              <% panels.forEach(function(panel) { %>
                <tr class="border-b last:border-0">
                  <td class="py-4 pr-4 align-top">
                    <div class="truncate font-semibold text-slate-900" title="<%= panel.name %>"><%= panel.name %></div>
                    <div class="mt-1 truncate text-sm text-slate-500" title="<%= panel.baseUrl %>"><%= panel.baseUrl %></div>
                  </td>
                  <td class="py-4 pr-4 align-top">
                    <span class="inline-flex items-center rounded-full px-2.5 py-1 text-xs font-semibold <%= panel.isActive ? 'bg-emerald-100 text-emerald-800' : 'bg-slate-100 text-slate-600' %>">
                      <%= panel.isActive ? t('Активна') : t('Отключена') %>
                    </span>
                    <% if (panel.lastSyncError) { %>
                      <div class="mt-2 max-w-xs text-xs leading-4 text-red-700"><%= panel.lastSyncError %></div>
                    <% } %>
                  </td>
                  <td class="py-4 pr-4 align-top"><%= panel.syncIntervalSeconds %> <%= t('с') %></td>
                  <td class="py-4 pr-4 align-top"><%= panel.lastSyncAt ? time(panel.lastSyncAt) : t('Никогда') %></td>
                  <td class="py-4 align-top">
                    <div class="flex flex-wrap justify-end gap-2">
                      <button type="button" data-sync-panel="<%= panel.id %>" data-icon="refresh" class="inline-flex min-h-[38px] items-center rounded-lg bg-blue-700 px-3 py-1.5 text-sm font-semibold text-white hover:bg-blue-800"><%= t('Синхронизировать') %></button>
                      <a href="/admin/threexui/<%= panel.id %>/edit" class="inline-flex min-h-[38px] items-center rounded-lg bg-slate-600 px-3 py-1.5 text-sm font-semibold text-white hover:bg-slate-700"><%= t('Редактировать') %></a>
                      <form method="POST" action="/admin/threexui/<%= panel.id %>/delete" data-confirm="<%= t('Удалить панель «{name}» и всю её статистику?', { name: panel.name }) %>" data-confirm-ok="<%= t('Удалить') %>" data-confirm-danger="true">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="inline-flex min-h-[38px] items-center rounded-lg bg-red-700 px-3 py-1.5 text-sm font-semibold text-white hover:bg-red-800"><%= t('Удалить') %></button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>
  </main>

  <script>
    const csrfToken = '<%= csrfToken %>';
    const syncAll = document.getElementById('syncAll');
    const syncButtons = [...document.querySelectorAll('[data-sync-panel]')];

    async function sync(url) {
      const response = await fetch(url, { method: 'POST', headers: { 'x-csrf-token': csrfToken } });
      const data = await response.json().catch(() => ({}));
      if (!response.ok && response.status !== 207) throw new Error(data.error || '<%= t('Синхронизация завершилась с ошибкой.') %>');
      return data;
    }

    syncAll?.addEventListener('click', async () => {
      uiSetBusy(syncAll, true, '<%= t('Синхронизация…') %>');
      try {
        await sync('/api/threexui/sync');
        uiToast('<%= t('Синхронизация завершена') %>', 'success');
        setTimeout(() => window.location.reload(), 600);
      } catch (error) {
        uiToast(error.message, 'error');
        uiSetBusy(syncAll, false);
      }
    });

    syncButtons.forEach(button => button.addEventListener('click', async () => {
      uiSetBusy(button, true, '<%= t('Синхронизация…') %>');
      try {
        await sync(`/api/threexui/${button.dataset.syncPanel}/sync`);
        uiToast('<%= t('Синхронизация завершена') %>', 'success');
        setTimeout(() => window.location.reload(), 600);
      } catch (error) {
        uiToast(error.message, 'error');
        uiSetBusy(button, false);
      }
    }));
  </script>
</body>
</html>
