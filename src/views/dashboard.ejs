<!DOCTYPE html>
<html lang="ru">

<head><%- include('partials/subscription-head', { title: `Админ-панель — ${appName}` }) %></head>

<body class="bg-slate-100 text-slate-900">
    <%- include('partials/subscription-header', { heading: 'Админ-панель' }) %>
    <main id="main" class="mx-auto max-w-6xl px-4 py-6 md:py-8">
        <section class="relative mb-4 overflow-hidden rounded-2xl bg-slate-900 p-5 text-white shadow-xl md:p-6">
            <div class="absolute -right-20 -top-24 h-64 w-64 rounded-full bg-blue-500/20 blur-3xl" aria-hidden="true"></div>
            <div class="relative grid gap-4 md:grid-cols-[1fr_auto] md:items-start">
                <div class="min-w-0">
                    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-blue-300">Центр управления</p>
                    <h2 class="mt-2 text-xl font-semibold tracking-tight md:text-2xl">Серверы и пользователи</h2>
                    <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-300">Управляйте ручными серверами, пользователями и автоматическими источниками VPN-подписок.</p>
                </div>
                <div class="flex items-center gap-2 text-xs text-slate-400 md:pt-1">
                    <svg viewBox="0 0 24 24" class="h-4 w-4 text-blue-300" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                    <span>Часовой пояс: <strong class="font-medium text-slate-200"><%= timezone %></strong></span>
                </div>
            </div>
        </section>
        <section class="mb-6 grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-4" aria-label="Сводка">
            <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm"><p class="text-sm text-slate-500">Серверы</p><p class="mt-1 text-3xl font-bold text-slate-900"><%= totals.servers.active || 0 %></p><p class="mt-1 text-xs text-slate-500"><%= totals.servers.total %> всего</p></div>
            <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm"><p class="text-sm text-slate-500">Пользователи</p><p class="mt-1 text-3xl font-bold text-slate-900"><%= totals.users.active || 0 %></p><p class="mt-1 text-xs text-slate-500"><%= totals.users.total %> всего</p></div>
            <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm"><p class="text-sm text-slate-500">Источники подписок</p><p class="mt-1 text-3xl font-bold text-slate-900"><%= stats.totalSources %></p><a href="/admin/subscription-sources" class="mt-1 inline-block text-xs font-semibold text-blue-700 hover:underline">Открыть каталог</a></div>
            <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm"><p class="text-sm text-slate-500">Рабочие узлы</p><p class="mt-1 text-3xl font-bold text-slate-900"><%= stats.healthyNodes %></p><p class="mt-1 text-xs text-slate-500">работают через VPN</p></div>
        </section>
        <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm md:p-6 mb-6 w-full" data-dashboard-collections>
            <div class="border-b border-slate-200" role="tablist" aria-label="Список управления">
                <div class="flex flex-wrap gap-2">
                    <a id="servers-tab" href="<%= collectionUrl('servers', { tab: 'servers' }) %>" class="tab-button <%= activeTab === 'servers' ? 'inline-flex min-h-[44px] items-center rounded-t-lg border-b-2 border-blue-700 px-3 py-2 text-sm font-semibold text-blue-700' : 'inline-flex min-h-[44px] items-center rounded-t-lg border-b-2 border-transparent px-3 py-2 text-sm font-semibold text-slate-500 hover:text-slate-700' %>" role="tab" aria-selected="<%= activeTab === 'servers' ? 'true' : 'false' %>" aria-controls="servers-panel" data-tab-button="servers">
                        Ручные серверы
                        <span class="<%= activeTab === 'servers' ? 'ml-2 rounded-full bg-blue-50 px-2 py-0.5 text-xs font-semibold text-blue-700' : 'ml-2 rounded-full bg-slate-100 px-2 py-0.5 text-xs font-semibold text-slate-600' %>"><%= totals.servers.total %></span>
                    </a>
                    <a id="users-tab" href="<%= collectionUrl('users', { tab: 'users' }) %>" class="tab-button <%= activeTab === 'users' ? 'inline-flex min-h-[44px] items-center rounded-t-lg border-b-2 border-blue-700 px-3 py-2 text-sm font-semibold text-blue-700' : 'inline-flex min-h-[44px] items-center rounded-t-lg border-b-2 border-transparent px-3 py-2 text-sm font-semibold text-slate-500 hover:text-slate-700' %>" role="tab" aria-selected="<%= activeTab === 'users' ? 'true' : 'false' %>" aria-controls="users-panel" data-tab-button="users">
                        Пользователи
                        <span class="<%= activeTab === 'users' ? 'ml-2 rounded-full bg-blue-50 px-2 py-0.5 text-xs font-semibold text-blue-700' : 'ml-2 rounded-full bg-slate-100 px-2 py-0.5 text-xs font-semibold text-slate-600' %>"><%= totals.users.total %></span>
                    </a>
                </div>
            </div>
            <div id="servers-panel" role="tabpanel" aria-labelledby="servers-tab" data-tab-panel="servers" class="pt-4" <%= activeTab === 'servers' ? '' : 'hidden' %>>
            <div class="flex flex-col gap-4 mb-4 pb-4 border-b sm:flex-row sm:items-center sm:justify-between">
                <div><h2 class="text-lg font-semibold text-gray-800">Ручные серверы</h2><p class="mt-1 text-sm text-slate-500">Проверьте доступность и управляйте подключениями.</p></div>
                <div class="flex w-full flex-col gap-2 sm:w-auto sm:flex-row">
                    <button id="checkAllBtn" onclick="checkAllServers()" class="min-h-[44px] flex-1 rounded-lg bg-blue-700 px-4 py-3 font-semibold text-white hover:bg-blue-800 sm:flex-none">Проверить все</button>
                    <a href="/admin/servers/new" class="inline-flex min-h-[44px] items-center justify-center rounded-lg border border-slate-300 px-4 py-3 font-semibold text-slate-700 hover:bg-slate-50">Добавить</a>
                </div>
            </div>
            <form method="GET" action="/admin" class="mb-4 flex flex-col gap-3 sm:flex-row">
                <input type="hidden" name="tab" value="servers">
                <% if (collections.users.search) { %><input type="hidden" name="userSearch" value="<%= collections.users.search %>"><% } %>
                <% if (collections.users.status !== 'all') { %><input type="hidden" name="userStatus" value="<%= collections.users.status %>"><% } %>
                <% if (collections.users.page > 1) { %><input type="hidden" name="userPage" value="<%= collections.users.page %>"><% } %>
                <label class="relative flex-1"><span class="sr-only">Поиск серверов</span><input id="serverSearch" name="serverSearch" type="search" value="<%= collections.servers.search %>" placeholder="Поиск по названию, хосту или протоколу" class="min-h-[44px] w-full rounded-lg border border-slate-300 px-3 py-2 pl-10 focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-100"><span class="pointer-events-none absolute left-3 top-3 text-slate-400" aria-hidden="true">⌕</span></label>
                <select id="serverStatus" name="serverStatus" class="min-h-[44px] rounded-lg border border-slate-300 px-3 py-2 focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-100" onchange="this.form.requestSubmit()">
                    <option value="all" <%= collections.servers.status === 'all' ? 'selected' : '' %>>Все серверы</option>
                    <option value="active" <%= collections.servers.status === 'active' ? 'selected' : '' %>>Только активные</option>
                    <option value="inactive" <%= collections.servers.status === 'inactive' ? 'selected' : '' %>>Только отключённые</option>
                </select>
                <button type="submit" class="inline-flex min-h-[44px] items-center justify-center rounded-lg bg-blue-700 px-4 py-2 font-semibold text-white hover:bg-blue-800">Найти</button>
                <% if (collections.servers.search || collections.servers.status !== 'all') { %><a href="<%= collectionUrl('servers', { serverSearch: '', serverStatus: 'all', serverPage: 1 }) %>" class="inline-flex min-h-[44px] items-center justify-center rounded-lg border border-slate-300 px-4 py-2 font-semibold text-slate-700 hover:bg-slate-50">Сбросить</a><% } %>
            </form>
            <% if (servers.length===0) { %>
                <p class="text-gray-500 text-center py-8"><%= totals.servers.total ? 'Серверы по заданным условиям не найдены.' : 'Нет серверов. Добавьте первый сервер.' %></p>
                <% } else { %>
                    <table class="w-full hidden md:table">
                        <thead>
                            <tr class="text-left text-gray-600 border-b">
                                <th class="pb-3">Название</th>
                                <th class="pb-3">Хост</th>
                                <th class="pb-3">Порт</th>
                                <th class="pb-3">Протокол</th>
                                <th class="pb-3">VPN / задержка</th>
                                <th class="pb-3 text-right">Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% servers.forEach(function(server) { %>
                                <tr class="border-b last:border-0 w-full" data-server-item data-server-item-id="<%= server.id %>" data-server-active="<%= server.is_active ? 'true' : 'false' %>">
                                    <td class="py-3 px-2 font-semibold">
                                        <span
                                            class="inline-block w-2 h-2 rounded-full mr-2 <%= server.is_active ? 'bg-green-500' : 'bg-red-500' %>"></span>
                                        <%= server.name %>
                                    </td>
                                    <td class="py-3">
                                        <%= server.host %>
                                    </td>
                                    <td class="py-3 px-2">
                                        <%= server.port %>
                                    </td>
                                    <td class="py-3">
                                        <%= server.protocol ? server.protocol.toUpperCase() : '' %>
                                    </td>
                                    <td class="py-3">
                                        <span id="status-<%= server.id %>"
class="inline-flex rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-600" data-latency="">Не проверен</span>
                                    </td>
                                    <td class="py-3 text-right">
                                        <div class="flex gap-2 items-center justify-end">
<button type="button" onclick="checkServer('<%= server.id %>')"
                                                 class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-blue-700 text-white hover:bg-blue-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-700" aria-label="Проверить VPN: <%= server.name %>" title="Проверить VPN">
                                                 <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12h3l2-7 4 14 2-7h7"/></svg>
                                             </button>
<a href="/admin/servers/<%= server.id %>/edit"
                                                 class="inline-flex min-h-[40px] items-center justify-center rounded-lg bg-slate-600 px-3 py-1.5 text-center text-sm font-semibold leading-tight text-white hover:bg-slate-700">Редактировать</a>
<form method="POST" action="/admin/servers/<%= server.id %>/delete"
                                                 data-confirm="Удалить сервер? Действие необратимо." data-confirm-ok="Удалить" data-confirm-danger="true">
                                                 <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <button type="submit"
                                                    class="inline-flex min-h-[38px] items-center justify-center rounded-lg bg-red-700 px-3 py-1.5 text-sm font-semibold text-white hover:bg-red-800">
                                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none"
                                                        viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round"
                                                            stroke-width="2"
                                                            d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                                    </svg>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                                <% }); %>
                        </tbody>
                    </table>
                    <div class="md:hidden space-y-3">
                        <% servers.forEach(function(server) { %>
                            <div class="border border-gray-200 rounded-lg p-4" data-server-item data-server-item-id="<%= server.id %>" data-server-active="<%= server.is_active ? 'true' : 'false' %>">
                                <div class="flex justify-between items-start mb-2">
                                    <div class="flex items-center gap-2">
                                        <span
                                            class="inline-block w-2 h-2 rounded-full flex-shrink-0 <%= server.is_active ? 'bg-green-500' : 'bg-red-500' %>"></span>
                                        <div>
                                            <div class="font-medium text-gray-800">
                                                <%= server.name %>
                                            </div>
                                            <div class="text-sm text-gray-500">
                                                <%= server.host %>:<%= server.port %>
                                            </div>
                                        </div>
                                    </div>
                                    <span id="status-mobile-<%= server.id %>"
class="inline-flex rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-600" data-latency="">Не проверен</span>
                                </div>
<div class="mb-3 text-xs text-gray-400">
                                     <%= server.protocol ? server.protocol.toUpperCase() : '' %> · проверка через Xray
                                 </div>
                                <div class="flex gap-2">
<button type="button" onclick="checkServer('<%= server.id %>')"
                                         class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-blue-700 text-white hover:bg-blue-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-700" aria-label="Проверить VPN: <%= server.name %>" title="Проверить VPN">
                                         <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12h3l2-7 4 14 2-7h7"/></svg>
                                     </button>
                                    <a href="/admin/servers/<%= server.id %>/edit"
                                        class="inline-flex h-10 flex-1 items-center justify-center rounded-lg bg-gray-500 px-3 text-sm text-white hover:bg-gray-600 text-center">Редактировать</a>
                                     <form method="POST" action="/admin/servers/<%= server.id %>/delete"
                                         data-confirm="Удалить сервер? Действие необратимо." data-confirm-ok="Удалить" data-confirm-danger="true">
                                         <input type="hidden" name="_csrf" value="<%= csrfToken %>">
 <button type="submit" aria-label="Удалить сервер <%= server.name %>" title="Удалить сервер"
                                                     class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-red-700 text-white hover:bg-red-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-700"><svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7l1-3h4l1 3"/></svg></button>
                                    </form>
                                </div>
                            </div>
                            <% }); %>
                    </div>
                    <% } %>
            <% if (collections.servers.total > 0) { %><nav class="mt-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between" aria-label="Пагинация серверов" data-pagination="servers">
                <p class="text-sm text-slate-500" data-pagination-info="servers" aria-live="polite">Показаны <%= collections.servers.total ? (collections.servers.page - 1) * collections.servers.perPage + 1 : 0 %>–<%= Math.min(collections.servers.page * collections.servers.perPage, collections.servers.total) %> из <%= collections.servers.total %> серверов</p>
                <div class="flex flex-wrap items-center gap-2">
                    <% if (collections.servers.totalPages > 1) { %>
                        <% if (collections.servers.page > 1) { %>
                            <a class="inline-flex min-h-[38px] items-center rounded-lg border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50" href="<%= collectionUrl('servers', { serverPage: collections.servers.page - 1 }) %>">Назад</a>
                        <% } else { %>
                            <span class="inline-flex min-h-[38px] cursor-not-allowed items-center rounded-lg border border-slate-200 px-3 py-2 text-sm font-medium text-slate-400" aria-disabled="true">Назад</span>
                        <% } %>
                    <% } %>
                    <div class="flex flex-wrap gap-1" data-page-numbers="servers">
                        <% paginationPages(collections.servers.page, collections.servers.totalPages).forEach(page => { %>
                            <% if (typeof page === 'number') { %>
                                <a class="inline-flex min-h-[38px] min-w-[38px] items-center justify-center rounded-lg px-3 py-2 text-sm font-medium <%= page === collections.servers.page ? 'bg-blue-700 text-white' : 'border border-slate-300 text-slate-700 hover:bg-slate-50' %>" href="<%= collectionUrl('servers', { serverPage: page }) %>" aria-label="<%= page === collections.servers.page ? `Текущая страница ${page}` : `Перейти на страницу ${page}` %>" <%= page === collections.servers.page ? 'aria-current="page"' : '' %>><%= page %></a>
                            <% } else { %><span class="inline-flex min-h-[38px] items-center px-1 text-sm text-slate-400" aria-hidden="true">…</span><% } %>
                        <% }); %>
                    </div>
                    <% if (collections.servers.totalPages > 1) { %>
                        <% if (collections.servers.page < collections.servers.totalPages) { %>
                            <a class="inline-flex min-h-[38px] items-center rounded-lg border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50" href="<%= collectionUrl('servers', { serverPage: collections.servers.page + 1 }) %>">Вперёд</a>
                        <% } else { %>
                            <span class="inline-flex min-h-[38px] cursor-not-allowed items-center rounded-lg border border-slate-200 px-3 py-2 text-sm font-medium text-slate-400" aria-disabled="true">Вперёд</span>
                        <% } %>
                    <% } %>
                </div>
            </nav><% } %>
            </div>

            <div id="users-panel" role="tabpanel" aria-labelledby="users-tab" data-tab-panel="users" class="pt-4" <%= activeTab === 'users' ? '' : 'hidden' %>>
            <div class="flex flex-col gap-4 mb-4 pb-4 border-b sm:flex-row sm:items-center sm:justify-between">
                <div><h2 class="text-lg font-semibold text-gray-800">Пользователи</h2><p class="mt-1 text-sm text-slate-500">Управляйте доступом и ссылками на подписки.</p></div>
                <div class="flex flex-wrap gap-2">
                    <a href="/admin/stats" class="inline-flex min-h-[44px] items-center justify-center rounded-lg border border-slate-300 bg-white px-4 py-3 font-semibold text-slate-700 hover:bg-slate-50">Статистика</a>
                    <a href="/admin/users/new" class="inline-flex min-h-[44px] items-center justify-center rounded-lg bg-blue-700 px-4 py-3 font-semibold text-white hover:bg-blue-800">Добавить</a>
                </div>
            </div>
            <form method="GET" action="/admin" class="mb-4 flex flex-col gap-3 sm:flex-row">
                <input type="hidden" name="tab" value="users">
                <% if (collections.servers.search) { %><input type="hidden" name="serverSearch" value="<%= collections.servers.search %>"><% } %>
                <% if (collections.servers.status !== 'all') { %><input type="hidden" name="serverStatus" value="<%= collections.servers.status %>"><% } %>
                <% if (collections.servers.page > 1) { %><input type="hidden" name="serverPage" value="<%= collections.servers.page %>"><% } %>
                <label class="relative flex-1"><span class="sr-only">Поиск пользователей</span><input id="userSearch" name="userSearch" type="search" value="<%= collections.users.search %>" placeholder="Поиск по имени пользователя или ID" class="min-h-[44px] w-full rounded-lg border border-slate-300 px-3 py-2 pl-10 focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-100"><span class="pointer-events-none absolute left-3 top-3 text-slate-400" aria-hidden="true">⌕</span></label>
                <select id="userStatus" name="userStatus" class="min-h-[44px] rounded-lg border border-slate-300 px-3 py-2 focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-100" onchange="this.form.requestSubmit()">
                    <option value="all" <%= collections.users.status === 'all' ? 'selected' : '' %>>Все пользователи</option>
                    <option value="active" <%= collections.users.status === 'active' ? 'selected' : '' %>>Только активные</option>
                    <option value="inactive" <%= collections.users.status === 'inactive' ? 'selected' : '' %>>Только отключённые</option>
                </select>
                <button type="submit" class="inline-flex min-h-[44px] items-center justify-center rounded-lg bg-blue-700 px-4 py-2 font-semibold text-white hover:bg-blue-800">Найти</button>
                <% if (collections.users.search || collections.users.status !== 'all') { %><a href="<%= collectionUrl('users', { userSearch: '', userStatus: 'all', userPage: 1 }) %>" class="inline-flex min-h-[44px] items-center justify-center rounded-lg border border-slate-300 px-4 py-2 font-semibold text-slate-700 hover:bg-slate-50">Сбросить</a><% } %>
            </form>
            <% if (users.length===0) { %>
                <p class="text-gray-500 text-center py-8"><%= totals.users.total ? 'Пользователи по заданным условиям не найдены.' : 'Нет пользователей. Добавьте первого пользователя.' %></p>
                <% } else { %>
                    <table class="w-full hidden md:table [&_th]:px-3 [&_td]:px-3">
                        <thead>
                            <tr class="text-left text-gray-600 border-b">
                                <th class="pb-3">Имя пользователя</th>
                                <th class="pb-3">Статус</th>
                                <th class="pb-3">Трафик</th>
                                <th class="pb-3">Последний запрос</th>
                                <th class="pb-3">Ссылка подписки</th>
                                <th class="pb-3">Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% users.forEach(function(user) { %>
                                <tr class="border-b last:border-0" data-user-item data-user-item-id="<%= user.id %>" data-user-active="<%= user.is_active ? 'true' : 'false' %>">
                                    <td class="py-3 align-top">
                                        <div class="font-medium"><%= user.username %></div>
                                        <div class="mt-2 flex max-w-[19rem] flex-wrap gap-1" aria-label="Ручные серверы">
                                            <% if (user.manual_servers.length) { %>
                                                <% user.manual_servers.forEach(server => { %><span class="inline-flex max-w-[10rem] truncate rounded-full bg-slate-100 px-2 py-0.5 text-[11px] font-medium text-slate-600" title="<%= server %>"><%= server %></span><% }); %>
                                            <% } else { %><span class="text-xs text-slate-400">Нет ручных серверов</span><% } %>
                                        </div>
                                        <div class="mt-1 flex max-w-[19rem] flex-wrap gap-1" aria-label="Подписки">
                                            <% if (user.subscription_sources.length) { %>
                                                <% user.subscription_sources.forEach(source => { %><span class="inline-flex max-w-[10rem] truncate rounded-full bg-blue-50 px-2 py-0.5 text-[11px] font-medium text-blue-700" title="<%= source %>"><%= source %></span><% }); %>
                                            <% } else { %><span class="text-xs text-slate-400">Нет подписок</span><% } %>
