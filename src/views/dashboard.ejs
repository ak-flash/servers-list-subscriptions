                                            </button>
                                        </div>
                                    </td>
                                    <td class="py-3">
                                        <div class="flex gap-2 items-center">
                                            <a href="/admin/users/<%= user.id %>/servers"
                                                class="inline-flex min-h-[38px] items-center rounded-lg bg-slate-600 px-3 py-1.5 text-sm font-semibold text-white hover:bg-slate-700">Серверы</a>
                                            <a href="/admin/users/<%= user.id %>/edit"
                                                class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-slate-600 text-white hover:bg-slate-700" aria-label="Редактировать пользователя <%= user.username %>" title="Редактировать"><svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 20h9"/><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5Z"/></svg></a>
<form method="POST" action="/admin/users/<%= user.id %>/delete"
                                                 data-confirm="Удалить пользователя и его подписки? Действие необратимо." data-confirm-ok="Удалить" data-confirm-danger="true">
                                                 <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <button type="submit"
                                                    class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-red-700 text-white hover:bg-red-800" aria-label="Удалить пользователя <%= user.username %>" title="Удалить"><svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 6h18"/><path stroke-linecap="round" stroke-linejoin="round" d="M8 6V4h8v2m-9 0 1 16h8l1-16M10 11v6m4-6v6"/></svg></button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                                <% }); %>
                        </tbody>
                    </table>
                    <div class="md:hidden space-y-3">
                        <% users.forEach(function(user) { %>
                            <div class="border border-gray-200 rounded-lg p-4" data-user-item data-user-item-id="<%= user.id %>" data-user-active="<%= user.is_active ? 'true' : 'false' %>">
                                <div class="flex justify-between items-start mb-2">
                                    <div class="font-medium text-gray-800">
                                        <%= user.username %>
                                    </div>
                                    <span
                                        class="px-2 py-1 text-xs rounded <%= user.is_active ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
                                        <%= user.is_active ? 'Активен' : 'Отключен' %>
                                    </span>
                                </div>
                                <div class="text-xs text-gray-400 mb-3">ID: <%= user.id %></div>
                                <div class="mb-3 space-y-1" aria-label="Привязки пользователя">
                                    <div class="flex flex-wrap gap-1">
                                        <% if (user.manual_servers.length) { %>
                                            <% user.manual_servers.forEach(server => { %><span class="inline-flex max-w-[14rem] truncate rounded-full bg-slate-100 px-2 py-0.5 text-[11px] font-medium text-slate-600" title="<%= server %>"><%= server %></span><% }); %>
                                        <% } else { %><span class="text-xs text-slate-400">Нет ручных серверов</span><% } %>
                                    </div>
                                    <div class="flex flex-wrap gap-1">
                                        <% if (user.subscription_sources.length) { %>
                                            <% user.subscription_sources.forEach(source => { %><span class="inline-flex max-w-[14rem] truncate rounded-full bg-blue-50 px-2 py-0.5 text-[11px] font-medium text-blue-700" title="<%= source %>"><%= source %></span><% }); %>
                                        <% } else { %><span class="text-xs text-slate-400">Нет подписок</span><% } %>
                                    </div>
                                </div>
                                <div class="mb-3 text-sm font-semibold text-slate-800"><%= user.formatted_monthly %></div>
                                        <div class="flex flex-wrap gap-2 mb-3">
                                            <button onclick="showQrModal('<%= user.id %>', '<%= user.username %>')"
                                                class="bg-green-600 text-white px-3 py-1 rounded text-sm hover:bg-green-700">
                                                QR код
                                            </button>
                                            <a href="/join/<%= user.id %>#Подписка_<%= user.username %>" target="_blank"
                                                class="bg-blue-50 px-3 py-1 rounded text-sm hover:bg-blue-100 text-blue-600">
                                                Ссылка
                                            </a>
                                        </div>
                                        <div class="flex flex-wrap gap-2">
                                            <a href="/admin/users/<%= user.id %>/servers"
                                                class="inline-flex min-h-[38px] items-center rounded-lg bg-slate-600 px-3 py-1.5 text-sm font-semibold text-white hover:bg-slate-700">Серверы</a>
                                            <a href="/admin/users/<%= user.id %>/edit"
                                                class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-slate-600 text-white hover:bg-slate-700" aria-label="Редактировать пользователя <%= user.username %>" title="Редактировать"><svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 20h9"/><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5Z"/></svg></a>
<form method="POST" action="/admin/users/<%= user.id %>/delete"
                                                 data-confirm="Удалить пользователя и его подписки? Действие необратимо." data-confirm-ok="Удалить" data-confirm-danger="true">
                                                 <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <button type="submit"
                                                    class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-red-700 text-white hover:bg-red-800" aria-label="Удалить пользователя <%= user.username %>" title="Удалить"><svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 6h18"/><path stroke-linecap="round" stroke-linejoin="round" d="M8 6V4h8v2m-9 0 1 16h8l1-16M10 11v6m4-6v6"/></svg></button>
                                            </form>
                                        </div>
                            </div>
                            <% }); %>
                    </div>
                    <% } %>
            <% if (collections.users.total > 0) { %><nav class="mt-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between" aria-label="Пагинация пользователей" data-pagination="users">
                <p class="text-sm text-slate-500" data-pagination-info="users" aria-live="polite">Показаны <%= collections.users.total ? (collections.users.page - 1) * collections.users.perPage + 1 : 0 %>–<%= Math.min(collections.users.page * collections.users.perPage, collections.users.total) %> из <%= collections.users.total %> пользователей</p>
                <div class="flex flex-wrap items-center gap-2">
                    <% if (collections.users.totalPages > 1) { %>
                        <% if (collections.users.page > 1) { %>
                            <a class="inline-flex min-h-[38px] items-center rounded-lg border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50" href="<%= collectionUrl('users', { userPage: collections.users.page - 1 }) %>">Назад</a>
                        <% } else { %>
                            <span class="inline-flex min-h-[38px] cursor-not-allowed items-center rounded-lg border border-slate-200 px-3 py-2 text-sm font-medium text-slate-400" aria-disabled="true">Назад</span>
                        <% } %>
                    <% } %>
                    <div class="flex flex-wrap gap-1" data-page-numbers="users">
                        <% paginationPages(collections.users.page, collections.users.totalPages).forEach(page => { %>
                            <% if (typeof page === 'number') { %>
                                <a class="inline-flex min-h-[38px] min-w-[38px] items-center justify-center rounded-lg px-3 py-2 text-sm font-medium <%= page === collections.users.page ? 'bg-blue-700 text-white' : 'border border-slate-300 text-slate-700 hover:bg-slate-50' %>" href="<%= collectionUrl('users', { userPage: page }) %>" aria-label="<%= page === collections.users.page ? `Текущая страница ${page}` : `Перейти на страницу ${page}` %>" <%= page === collections.users.page ? 'aria-current="page"' : '' %>><%= page %></a>
                            <% } else { %><span class="inline-flex min-h-[38px] items-center px-1 text-sm text-slate-400" aria-hidden="true">…</span><% } %>
                        <% }); %>
                    </div>
                    <% if (collections.users.totalPages > 1) { %>
                        <% if (collections.users.page < collections.users.totalPages) { %>
                            <a class="inline-flex min-h-[38px] items-center rounded-lg border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50" href="<%= collectionUrl('users', { userPage: collections.users.page + 1 }) %>">Вперёд</a>
                        <% } else { %>
                            <span class="inline-flex min-h-[38px] cursor-not-allowed items-center rounded-lg border border-slate-200 px-3 py-2 text-sm font-medium text-slate-400" aria-disabled="true">Вперёд</span>
                        <% } %>
                    <% } %>
                </div>
            </nav><% } %>
            </div>
        </div>
    </main>

    <div id="qr-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/50" style="display: none;">
        <div class="bg-white rounded-lg shadow-xl p-6 max-w-sm w-full mx-4">
            <div class="flex justify-between items-center mb-4">
                <h3 id="qr-modal-title" class="text-lg font-semibold">QR код</h3>
                <button onclick="closeQrModal()" class="text-gray-500 hover:text-gray-700 text-2xl">&times;</button>
            </div>
            <div class="flex justify-center">
                <img id="qr-modal-img" src="" alt="QR код" class="rounded">
            </div>
            <p class="text-center text-sm text-gray-500 mt-3">Сканируйте QR код приложением</p>
        </div>
    </div>

    <script>
        const csrfToken = '<%= csrfToken %>';

        async function showQrModal(userId, username) {
            try {
                const response = await fetch('/join/' + userId + '/qr-img');
                const data = await response.json();
                document.getElementById('qr-modal-title').textContent = 'QR код - ' + data.username;
                document.getElementById('qr-modal-img').src = data.qrCode;
                document.getElementById('qr-modal').style.display = 'flex';
            } catch (err) {
                uiToast('Не удалось загрузить QR-код', 'error');
            }
        }

        function closeQrModal() {
            document.getElementById('qr-modal').style.display = 'none';
        }

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') closeQrModal();
        });

        document.getElementById('qr-modal').addEventListener('click', function (e) {
            if (e.target === this) closeQrModal();
        });

        async function checkServer(serverId) {
            const statusEl = document.getElementById('status-' + serverId);
            const statusMobileEl = document.getElementById('status-mobile-' + serverId);
            const updateStatus = (el) => {
                if (!el) return;
                el.textContent = 'Проверка...';
                el.className = 'px-2 py-1 text-xs rounded bg-yellow-100 text-yellow-600';
            };
            updateStatus(statusEl);
            updateStatus(statusMobileEl);

            try {
                const response = await fetch('/api/servers/' + serverId + '/check', { method: 'POST', headers: { 'x-csrf-token': csrfToken } });
                const data = await response.json();

                const applyResult = (el) => {
                    if (!el) return;
if (data.status === 'healthy') {
                         el.textContent = `${Math.round(data.latency_ms)} мс`;
                         el.className = 'inline-flex rounded-full bg-emerald-100 px-2.5 py-1 text-xs font-semibold text-emerald-800';
                     } else if (data.status === 'degraded') {
                         el.textContent = data.latency_ms ? `${Math.round(data.latency_ms)} мс · нестабильно` : 'Нестабильно';
                         el.className = 'inline-flex rounded-full bg-amber-100 px-2.5 py-1 text-xs font-semibold text-amber-800';
                     } else if (data.status === 'test_failed') {
                         el.textContent = 'Тест не пройден';
                         el.className = 'inline-flex rounded-full bg-orange-100 px-2.5 py-1 text-xs font-semibold text-orange-800';
                     } else {
                         el.textContent = data.status === 'unsupported' ? 'Не поддерживается' : 'Недоступен';
                         el.className = 'inline-flex rounded-full bg-red-100 px-2.5 py-1 text-xs font-semibold text-red-800';
                     }
                };
                applyResult(statusEl);
                applyResult(statusMobileEl);
            } catch (err) {
                const applyError = (el) => {
                    if (!el) return;
                    el.textContent = 'Ошибка';
                    el.className = 'px-2 py-1 text-xs rounded bg-red-100 text-red-800';
                };
                applyError(statusEl);
                applyError(statusMobileEl);
            }
        }

        async function checkAllServers() {
            const btn = document.getElementById('checkAllBtn');
            uiSetBusy(btn, true, 'Проверка…');
            uiProgress.set(20);

            try {
                const response = await fetch('/api/servers/check', { method: 'POST', headers: { 'x-csrf-token': csrfToken } });
                const data = await response.json();
                uiProgress.set(75);

                data.results.forEach(result => {
                    const statusEl = document.getElementById('status-' + result.id);
                    const statusMobileEl = document.getElementById('status-mobile-' + result.id);
                    const applyResult = (el) => {
                        if (!el) return;
if (result.status === 'healthy') {
                             el.textContent = `${Math.round(result.latency_ms)} мс`;
                             el.className = 'inline-flex rounded-full bg-emerald-100 px-2.5 py-1 text-xs font-semibold text-emerald-800';
                         } else if (result.status === 'degraded') {
                             el.textContent = result.latency_ms ? `${Math.round(result.latency_ms)} мс · нестабильно` : 'Нестабильно';
                             el.className = 'inline-flex rounded-full bg-amber-100 px-2.5 py-1 text-xs font-semibold text-amber-800';
                         } else if (result.status === 'test_failed') {
                             el.textContent = 'Тест не пройден';
                             el.className = 'inline-flex rounded-full bg-orange-100 px-2.5 py-1 text-xs font-semibold text-orange-800';
                         } else {
                             el.textContent = result.status === 'unsupported' ? 'Не поддерживается' : 'Недоступен';
                             el.className = 'inline-flex rounded-full bg-red-100 px-2.5 py-1 text-xs font-semibold text-red-800';
                         }
                    };
                    applyResult(statusEl);
                    applyResult(statusMobileEl);
                });

                uiProgress.done();
                const failed = data.results.filter(r => r.status !== 'healthy').length;
                uiToast(`Готово: ${data.results.length} серверов, проблем: ${failed}`, failed > 0 ? 'info' : 'success', 4000);
            } catch (err) {
                uiProgress.done();
                uiToast('Ошибка проверки серверов', 'error');
            } finally {
                uiSetBusy(btn, false);
            }
        }
    </script>


</body>

</html>
