<!DOCTYPE html>
<html lang="ru">

<head><%- include('partials/subscription-head', { title: `Админ-панель — ${appName}` }) %></head>

<body class="bg-slate-100 text-slate-900">
    <%- include('partials/subscription-header', { heading: 'Админ-панель' }) %>
    <main id="main" class="mx-auto max-w-6xl px-4 py-6 md:py-8">
        <section class="relative mb-4 overflow-hidden rounded-2xl bg-slate-900 p-4 text-white shadow-xl md:p-6">
            <div class="absolute -right-20 -top-24 h-64 w-64 rounded-full bg-blue-500/20 blur-3xl" aria-hidden="true"></div>
            <div class="relative flex flex-col justify-between gap-4 lg:flex-row lg:items-center">
                <div class="min-w-0 max-w-xl">
                    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-blue-300">Центр управления</p>
                    <h2 class="mt-1 text-xl font-semibold tracking-tight md:text-2xl">Серверы и пользователи</h2>
                    <p class="mt-2 text-sm leading-5 text-slate-300">Управляйте ручными серверами, пользователями и автоматическими источниками VPN-подписок.</p>
                    <p class="mt-1 text-xs text-slate-400">Время отображается по часовому поясу <%= timezone %>.</p>
                </div>
                <div class="flex w-full flex-col gap-2 sm:w-auto sm:flex-row sm:flex-wrap sm:justify-end">
                    <a href="/admin/servers/new" class="inline-flex min-h-[38px] items-center justify-center rounded-lg bg-emerald-500 px-3 py-2 text-sm font-semibold text-white hover:bg-emerald-400">Добавить сервер</a>
                    <a href="/admin/subscription-sources" class="inline-flex min-h-[38px] items-center justify-center rounded-lg border border-white/20 px-3 py-2 text-sm font-semibold text-white hover:bg-white/10">Источники подписок</a>
                    <a href="/admin/threexui" class="inline-flex min-h-[38px] items-center justify-center rounded-lg border border-white/20 px-3 py-2 text-sm font-semibold text-white hover:bg-white/10">3x-ui панели</a>
                </div>
            </div>
        </section>
        <section class="mb-6 grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-4" aria-label="Сводка">
            <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm"><p class="text-sm text-slate-500">Серверы</p><p class="mt-1 text-3xl font-bold text-slate-900"><%= servers.filter(server => server.is_active).length %></p><p class="mt-1 text-xs text-slate-500"><%= servers.length %> всего</p></div>
            <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm"><p class="text-sm text-slate-500">Пользователи</p><p class="mt-1 text-3xl font-bold text-slate-900"><%= users.filter(user => user.is_active).length %></p><p class="mt-1 text-xs text-slate-500"><%= users.length %> всего</p></div>
            <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm"><p class="text-sm text-slate-500">Источники подписок</p><p class="mt-1 text-3xl font-bold text-slate-900"><%= stats.totalSources %></p><a href="/admin/subscription-sources" class="mt-1 inline-block text-xs font-semibold text-blue-700 hover:underline">Открыть каталог</a></div>
            <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm"><p class="text-sm text-slate-500">Рабочие узлы</p><p class="mt-1 text-3xl font-bold text-slate-900"><%= stats.healthyNodes %></p><p class="mt-1 text-xs text-slate-500">работают через VPN</p></div>
        </section>
        <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm md:p-6 mb-6 w-full">
            <div class="flex flex-col gap-4 mb-4 pb-4 border-b sm:flex-row sm:items-center sm:justify-between">
                <div><h2 class="text-lg font-semibold text-gray-800">Ручные серверы</h2><p class="mt-1 text-sm text-slate-500">Проверьте доступность и управляйте подключениями.</p></div>
                <div class="flex w-full flex-col gap-2 sm:w-auto sm:flex-row">
                    <button id="checkAllBtn" onclick="checkAllServers()" class="min-h-[44px] flex-1 rounded-lg bg-blue-700 px-4 py-3 font-semibold text-white hover:bg-blue-800 sm:flex-none">Проверить все</button>
                    <a href="/admin/servers/new" class="inline-flex min-h-[44px] items-center justify-center rounded-lg border border-slate-300 px-4 py-3 font-semibold text-slate-700 hover:bg-slate-50">Добавить</a>
                </div>
            </div>
            <div class="mb-4 flex flex-col gap-3 sm:flex-row">
                <label class="relative flex-1"><span class="sr-only">Поиск серверов</span><input id="serverSearch" type="search" placeholder="Поиск по названию, хосту или протоколу" class="min-h-[44px] w-full rounded-lg border border-slate-300 px-3 py-2 pl-10 focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-100"><span class="pointer-events-none absolute left-3 top-3 text-slate-400" aria-hidden="true">⌕</span></label>
                <select id="serverFilter" class="min-h-[44px] rounded-lg border border-slate-300 px-3 py-2 focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-100"><option value="all">Все серверы</option><option value="active">Только активные</option><option value="inactive">Только отключённые</option></select>
            </div>
            <% if (servers.length===0) { %>
                <p class="text-gray-500 text-center py-8">Нет серверов. Добавьте первый сервер.</p>
                <% } else { %>
                    <table class="w-full hidden md:table">
                        <thead>
                            <tr class="text-left text-gray-600 border-b">
                                <th class="pb-3">Название</th>
                                <th class="pb-3">Хост</th>
                                <th class="pb-3">Порт</th>
                                <th class="pb-3">Протокол</th>
                                <th class="pb-3">VPN / задержка</th>
                                <th class="pb-3 text-right">Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% servers.forEach(function(server) { %>
                                <tr class="border-b last:border-0 w-full" data-server-item data-server-search="<%= `${server.name} ${server.host} ${server.protocol || ''}`.toLowerCase() %>" data-server-active="<%= server.is_active ? 'true' : 'false' %>">
                                    <td class="py-3 px-2 font-semibold">
                                        <span
                                            class="inline-block w-2 h-2 rounded-full mr-2 <%= server.is_active ? 'bg-green-500' : 'bg-red-500' %>"></span>
                                        <%= server.name %>
                                    </td>
                                    <td class="py-3">
                                        <%= server.host %>
                                    </td>
                                    <td class="py-3 px-2">
                                        <%= server.port %>
                                    </td>
                                    <td class="py-3">
                                        <%= server.protocol ? server.protocol.toUpperCase() : '' %>
                                    </td>
                                    <td class="py-3">
                                        <span id="status-<%= server.id %>"
class="inline-flex rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-600" data-latency="">Не проверен</span>
                                    </td>
                                    <td class="py-3 text-right">
                                        <div class="flex gap-2 items-center justify-end">
<button type="button" onclick="checkServer('<%= server.id %>')"
                                                 class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-blue-700 text-white hover:bg-blue-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-700" aria-label="Проверить VPN: <%= server.name %>" title="Проверить VPN">
                                                 <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12h3l2-7 4 14 2-7h7"/></svg>
                                             </button>
<a href="/admin/servers/<%= server.id %>/edit"
                                                 class="inline-flex min-h-[40px] items-center justify-center rounded-lg bg-slate-600 px-3 py-1.5 text-center text-sm font-semibold leading-tight text-white hover:bg-slate-700">Редактировать</a>
<form method="POST" action="/admin/servers/<%= server.id %>/delete"
                                                 onsubmit="return confirm('Удалить сервер?')">
                                                 <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <button type="submit"
                                                    class="inline-flex min-h-[38px] items-center justify-center rounded-lg bg-red-700 px-3 py-1.5 text-sm font-semibold text-white hover:bg-red-800">
                                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none"
                                                        viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round"
                                                            stroke-width="2"
                                                            d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                                    </svg>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                                <% }); %>
                        </tbody>
                    </table>
                    <div class="md:hidden space-y-3">
                        <% servers.forEach(function(server) { %>
                            <div class="border border-gray-200 rounded-lg p-4" data-server-item data-server-search="<%= `${server.name} ${server.host} ${server.protocol || ''}`.toLowerCase() %>" data-server-active="<%= server.is_active ? 'true' : 'false' %>">
                                <div class="flex justify-between items-start mb-2">
                                    <div class="flex items-center gap-2">
                                        <span
                                            class="inline-block w-2 h-2 rounded-full flex-shrink-0 <%= server.is_active ? 'bg-green-500' : 'bg-red-500' %>"></span>
                                        <div>
                                            <div class="font-medium text-gray-800">
                                                <%= server.name %>
                                            </div>
                                            <div class="text-sm text-gray-500">
                                                <%= server.host %>:<%= server.port %>
                                            </div>
                                        </div>
                                    </div>
                                    <span id="status-mobile-<%= server.id %>"
class="inline-flex rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-600" data-latency="">Не проверен</span>
                                </div>
<div class="mb-3 text-xs text-gray-400">
                                     <%= server.protocol ? server.protocol.toUpperCase() : '' %> · проверка через Xray
                                 </div>
                                <div class="flex gap-2">
<button type="button" onclick="checkServer('<%= server.id %>')"
                                         class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-blue-700 text-white hover:bg-blue-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-700" aria-label="Проверить VPN: <%= server.name %>" title="Проверить VPN">
                                         <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12h3l2-7 4 14 2-7h7"/></svg>
                                     </button>
                                    <a href="/admin/servers/<%= server.id %>/edit"
                                        class="inline-flex h-10 flex-1 items-center justify-center rounded-lg bg-gray-500 px-3 text-sm text-white hover:bg-gray-600 text-center">Редактировать</a>
                                     <form method="POST" action="/admin/servers/<%= server.id %>/delete"
                                         onsubmit="return confirm('Удалить сервер?')">
                                         <input type="hidden" name="_csrf" value="<%= csrfToken %>">
 <button type="submit" aria-label="Удалить сервер <%= server.name %>" title="Удалить сервер"
                                                     class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-red-700 text-white hover:bg-red-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-700"><svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7l1-3h4l1 3"/></svg></button>
                                    </form>
                                </div>
                            </div>
                            <% }); %>
                    </div>
                    <% } %>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm md:p-6 w-full mb-6">
            <div class="flex flex-col gap-4 mb-4 pb-4 border-b sm:flex-row sm:items-center sm:justify-between">
                <div><h2 class="text-lg font-semibold text-gray-800">Пользователи</h2><p class="mt-1 text-sm text-slate-500">Управляйте доступом и ссылками на подписки.</p></div>
                <div class="flex flex-wrap gap-2">
                    <a href="/admin/stats" class="inline-flex min-h-[44px] items-center justify-center rounded-lg border border-slate-300 bg-white px-4 py-3 font-semibold text-slate-700 hover:bg-slate-50">Статистика</a>
                    <a href="/admin/users/new" class="inline-flex min-h-[44px] items-center justify-center rounded-lg bg-blue-700 px-4 py-3 font-semibold text-white hover:bg-blue-800">Добавить</a>
                </div>
            </div>
            <div class="mb-4 flex flex-col gap-3 sm:flex-row">
                <label class="relative flex-1"><span class="sr-only">Поиск пользователей</span><input id="userSearch" type="search" placeholder="Поиск по имени пользователя или ID" class="min-h-[44px] w-full rounded-lg border border-slate-300 px-3 py-2 pl-10 focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-100"><span class="pointer-events-none absolute left-3 top-3 text-slate-400" aria-hidden="true">⌕</span></label>
                <select id="userFilter" class="min-h-[44px] rounded-lg border border-slate-300 px-3 py-2 focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-100"><option value="all">Все пользователи</option><option value="active">Только активные</option><option value="inactive">Только отключённые</option></select>
            </div>
            <% if (users.length===0) { %>
                <p class="text-gray-500 text-center py-8">Нет пользователей. Добавьте первого пользователя.</p>
                <% } else { %>
                    <table class="w-full hidden md:table">
                        <thead>
                            <tr class="text-left text-gray-600 border-b">
                                <th class="pb-3">Имя пользователя</th>
                                <th class="pb-3">Статус</th>
                                <th class="pb-3">Трафик</th>
                                <th class="pb-3">Последний запрос</th>
                                <th class="pb-3">Ссылка подписки</th>
                                <th class="pb-3">Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% users.forEach(function(user) { %>
                                <tr class="border-b last:border-0" data-user-item data-user-search="<%= `${user.username} ${user.id}`.toLowerCase() %>" data-user-active="<%= user.is_active ? 'true' : 'false' %>">
                                    <td class="py-3">
                                        <%= user.username %>
                                    </td>
                                    <td class="py-3">
                                        <span
                                            class="px-2 py-1 text-xs rounded <%= user.is_active ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
                                            <%= user.is_active ? 'Активен' : 'Отключен' %>
                                        </span>
                                    </td>
                                    <td class="py-3">
                                        <div class="text-sm font-semibold text-slate-800"><%= user.formatted_monthly %></div>
                                    </td>
                                    <td class="py-3 font-semibold">
                                        <%= user.last_request_at ? date(user.last_request_at) : '—' %>
                                    </td>
                                    <td class="py-3">
                                        <div class="flex items-center gap-2">
                                            <a href="/join/<%= user.id %>#Подписка_<%= user.username %>" target="_blank"
                                                class="bg-blue-50 px-2 py-1 rounded text-sm break-all hover:bg-blue-100 text-blue-600">
                                                <%= user.id %>
                                            </a>
                                            <button onclick="showQrModal('<%= user.id %>', '<%= user.username %>')"
                                                class="bg-green-600 text-white px-2 py-1 rounded text-sm hover:bg-green-700">
                                                QR
                                            </button>
                                        </div>
                                    </td>
                                    <td class="py-3">
                                        <div class="flex gap-2 items-center">
                                            <a href="/admin/users/<%= user.id %>/servers"
                                                class="inline-flex min-h-[38px] items-center rounded-lg bg-slate-600 px-3 py-1.5 text-sm font-semibold text-white hover:bg-slate-700">Серверы</a>
                                            <a href="/admin/users/<%= user.id %>/edit"
                                                class="inline-flex min-h-[38px] items-center rounded-lg bg-slate-600 px-3 py-1.5 text-sm font-semibold text-white hover:bg-slate-700">Редактировать</a>
<form method="POST" action="/admin/users/<%= user.id %>/delete"
                                                 onsubmit="return confirm('Удалить пользователя?')">
                                                 <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <button type="submit"
                                                    class="inline-flex min-h-[38px] items-center rounded-lg bg-red-700 px-3 py-1.5 text-sm font-semibold text-white hover:bg-red-800">Удалить</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                                <% }); %>
                        </tbody>
                    </table>
                    <div class="md:hidden space-y-3">
                        <% users.forEach(function(user) { %>
                            <div class="border border-gray-200 rounded-lg p-4" data-user-item data-user-search="<%= `${user.username} ${user.id}`.toLowerCase() %>" data-user-active="<%= user.is_active ? 'true' : 'false' %>">
                                <div class="flex justify-between items-start mb-2">
                                    <div class="font-medium text-gray-800">
                                        <%= user.username %>
                                    </div>
                                    <span
                                        class="px-2 py-1 text-xs rounded <%= user.is_active ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
                                        <%= user.is_active ? 'Активен' : 'Отключен' %>
                                    </span>
                                </div>
                                <div class="text-xs text-gray-400 mb-3">ID: <%= user.id %>
                                </div>
                                <div class="mb-3">
                                    <div class="text-sm font-semibold text-slate-800"><%= user.formatted_total %></div>
                                    <div class="mt-1 text-xs text-slate-500">Месяц: <%= user.formatted_monthly %></div>
                                </div>
                                        <div class="flex flex-wrap gap-2 mb-3">
                                            <button onclick="showQrModal('<%= user.id %>', '<%= user.username %>')"
                                                class="bg-green-600 text-white px-3 py-1 rounded text-sm hover:bg-green-700">
                                                QR код
                                            </button>
                                            <a href="/join/<%= user.id %>#Подписка_<%= user.username %>" target="_blank"
                                                class="bg-blue-50 px-3 py-1 rounded text-sm hover:bg-blue-100 text-blue-600">
                                                Ссылка
                                            </a>
                                        </div>
                                        <div class="flex flex-wrap gap-2">
                                            <a href="/admin/users/<%= user.id %>/servers"
                                                class="inline-flex min-h-[38px] items-center rounded-lg bg-slate-600 px-3 py-1.5 text-sm font-semibold text-white hover:bg-slate-700">Серверы</a>
                                            <a href="/admin/users/<%= user.id %>/edit"
                                                class="inline-flex min-h-[38px] items-center rounded-lg bg-slate-600 px-3 py-1.5 text-sm font-semibold text-white hover:bg-slate-700">Редактировать</a>
<form method="POST" action="/admin/users/<%= user.id %>/delete"
                                                 onsubmit="return confirm('Удалить пользователя?')">
                                                 <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <button type="submit"
                                                    class="inline-flex min-h-[38px] items-center rounded-lg bg-red-700 px-3 py-1.5 text-sm font-semibold text-white hover:bg-red-800">Удалить</button>
                                            </form>
                                        </div>
                            </div>
                            <% }); %>
                    </div>
                    <% } %>
        </div>
    </main>

    <div id="qr-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/50" style="display: none;">
        <div class="bg-white rounded-lg shadow-xl p-6 max-w-sm w-full mx-4">
            <div class="flex justify-between items-center mb-4">
                <h3 id="qr-modal-title" class="text-lg font-semibold">QR код</h3>
                <button onclick="closeQrModal()" class="text-gray-500 hover:text-gray-700 text-2xl">&times;</button>
            </div>
            <div class="flex justify-center">
                <img id="qr-modal-img" src="" alt="QR код" class="rounded">
            </div>
            <p class="text-center text-sm text-gray-500 mt-3">Сканируйте QR код приложением</p>
        </div>
    </div>

    <script>
        const csrfToken = '<%= csrfToken %>';

        async function showQrModal(userId, username) {
            try {
                const response = await fetch('/join/' + userId + '/qr-img');
                const data = await response.json();
                document.getElementById('qr-modal-title').textContent = 'QR код - ' + data.username;
                document.getElementById('qr-modal-img').src = data.qrCode;
                document.getElementById('qr-modal').style.display = 'flex';
            } catch (err) {
                alert('Ошибка загрузки QR кода');
            }
        }

        function closeQrModal() {
            document.getElementById('qr-modal').style.display = 'none';
        }

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') closeQrModal();
        });

        document.getElementById('qr-modal').addEventListener('click', function (e) {
            if (e.target === this) closeQrModal();
        });

        async function checkServer(serverId) {
            const statusEl = document.getElementById('status-' + serverId);
            const statusMobileEl = document.getElementById('status-mobile-' + serverId);
            const updateStatus = (el) => {
                if (!el) return;
                el.textContent = 'Проверка...';
                el.className = 'px-2 py-1 text-xs rounded bg-yellow-100 text-yellow-600';
            };
            updateStatus(statusEl);
            updateStatus(statusMobileEl);

            try {
                const response = await fetch('/api/servers/' + serverId + '/check', { method: 'POST', headers: { 'x-csrf-token': csrfToken } });
                const data = await response.json();

                const applyResult = (el) => {
                    if (!el) return;
if (data.status === 'healthy') {
                         el.textContent = `${Math.round(data.latency_ms)} мс`;
                         el.className = 'inline-flex rounded-full bg-emerald-100 px-2.5 py-1 text-xs font-semibold text-emerald-800';
                     } else if (data.status === 'degraded') {
                         el.textContent = data.latency_ms ? `${Math.round(data.latency_ms)} мс · нестабильно` : 'Нестабильно';
                         el.className = 'inline-flex rounded-full bg-amber-100 px-2.5 py-1 text-xs font-semibold text-amber-800';
                     } else if (data.status === 'test_failed') {
                         el.textContent = 'Тест не пройден';
                         el.className = 'inline-flex rounded-full bg-orange-100 px-2.5 py-1 text-xs font-semibold text-orange-800';
                     } else {
                         el.textContent = data.status === 'unsupported' ? 'Не поддерживается' : 'Недоступен';
                         el.className = 'inline-flex rounded-full bg-red-100 px-2.5 py-1 text-xs font-semibold text-red-800';
                     }
                };
                applyResult(statusEl);
                applyResult(statusMobileEl);
            } catch (err) {
                const applyError = (el) => {
                    if (!el) return;
                    el.textContent = 'Ошибка';
                    el.className = 'px-2 py-1 text-xs rounded bg-red-100 text-red-800';
                };
                applyError(statusEl);
                applyError(statusMobileEl);
            }
        }

        async function checkAllServers() {
            const btn = document.getElementById('checkAllBtn');
            btn.disabled = true;
            btn.textContent = 'Проверка...';

            try {
                const response = await fetch('/api/servers/check', { method: 'POST', headers: { 'x-csrf-token': csrfToken } });
                const data = await response.json();

                data.results.forEach(result => {
                    const statusEl = document.getElementById('status-' + result.id);
                    const statusMobileEl = document.getElementById('status-mobile-' + result.id);
                    const applyResult = (el) => {
                        if (!el) return;
if (result.status === 'healthy') {
                             el.textContent = `${Math.round(result.latency_ms)} мс`;
                             el.className = 'inline-flex rounded-full bg-emerald-100 px-2.5 py-1 text-xs font-semibold text-emerald-800';
                         } else if (result.status === 'degraded') {
                             el.textContent = result.latency_ms ? `${Math.round(result.latency_ms)} мс · нестабильно` : 'Нестабильно';
                             el.className = 'inline-flex rounded-full bg-amber-100 px-2.5 py-1 text-xs font-semibold text-amber-800';
                         } else if (result.status === 'test_failed') {
                             el.textContent = 'Тест не пройден';
                             el.className = 'inline-flex rounded-full bg-orange-100 px-2.5 py-1 text-xs font-semibold text-orange-800';
                         } else {
                             el.textContent = result.status === 'unsupported' ? 'Не поддерживается' : 'Недоступен';
                             el.className = 'inline-flex rounded-full bg-red-100 px-2.5 py-1 text-xs font-semibold text-red-800';
                         }
                    };
                    applyResult(statusEl);
                    applyResult(statusMobileEl);
                });
            } catch (err) {
                alert('Ошибка проверки серверов');
            } finally {
                btn.disabled = false;
                btn.textContent = 'Проверить';
            }
        }
    </script>

    <script>
        function setupCollectionFilters(searchId, filterId, itemSelector, emptyText) {
            const search = document.getElementById(searchId);
            const filter = document.getElementById(filterId);
            const items = [...document.querySelectorAll(itemSelector)];
            if (!search || !filter || !items.length) return;

            const empty = document.createElement('p');
            empty.className = 'hidden mb-4 rounded-lg bg-slate-50 py-4 text-center text-sm text-slate-500';
            empty.textContent = emptyText;
            search.parentElement.parentElement.after(empty);

            const dataPrefix = itemSelector.includes('server') ? 'server' : 'user';
            const apply = () => {
                const query = search.value.trim().toLowerCase();
                const state = filter.value;
                let visible = 0;
                items.forEach(item => {
                    const matchesQuery = !query || item.dataset[`${dataPrefix}Search`].includes(query);
                    const matchesState = state === 'all' || item.dataset[`${dataPrefix}Active`] === (state === 'active' ? 'true' : 'false');
                    item.classList.toggle('hidden', !matchesQuery || !matchesState);
                    if (matchesQuery && matchesState) visible += 1;
                });
                empty.classList.toggle('hidden', visible > 0);
            };

            search.addEventListener('input', apply);
            filter.addEventListener('change', apply);
        }

        setupCollectionFilters('serverSearch', 'serverFilter', '[data-server-item]', 'Серверы по заданным условиям не найдены.');
        setupCollectionFilters('userSearch', 'userFilter', '[data-user-item]', 'Пользователи по заданным условиям не найдены.');

        function formatBytes(bytes) {
            if (bytes === 0) return '0 B';
            const k = 1024;
            const sizes = ['B', 'KB', 'MB', 'GB', 'TB'];
            const i = Math.floor(Math.log(bytes) / Math.log(k));
            return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
        }
    </script>
</body>

</html>
