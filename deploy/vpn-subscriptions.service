[Unit]
Description=VPN subscription catalog and connection checker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vpn-subscriptions
Group=vpn-subscriptions
WorkingDirectory=/opt/vpn-subscriptions
Environment=NODE_ENV=production
EnvironmentFile=/opt/vpn-subscriptions/.env
ExecStart=/usr/bin/node /opt/vpn-subscriptions/src/index.js
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/vpn-subscriptions/data
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
