PORT=4000
APP_NAME=Подписки
SESSION_SECRET=replace-with-a-random-long-secret
# Секретный сегмент URL для webhook 3x-ui
WEBHOOK_SECRET=replace-with-a-webhook-secret
# URL для 3x-ui: https://your-domain.com/api/webhook/traffic/<WEBHOOK_SECRET>
# Используются только при создании нового администратора; после первого входа пароль можно удалить
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-temporary-admin-password
# Публичный домен для QR кодов
PUBLIC_DOMAIN=your-domain.com
# Для Linux за HTTPS reverse proxy:
# HOST=127.0.0.1
# TRUST_PROXY=1
# Secure-cookie сессии: 'auto' (по умолчанию) — включается только на реальном HTTPS.
# SESSION_COOKIE_SECURE=1 — включить всегда (например, TLS терминируется шлюзом без передачи заголовков).
# SESSION_COOKIE_SECURE=0 — отключить (доступ по HTTP без TLS).

# Xray — временный VPN-клиент для проверок, не VPN-сервер для пользователей.
# Пусто: /usr/local/bin/xray на Linux, tools/xray/xray.exe в проекте на Windows.
# Можно задать абсолютный путь: E:/laragon/www/subscriptions/tools/xray/xray.exe
XRAY_PATH=
XRAY_VERSION=26.3.27
# SHA-256 установленного бинарника (показывают scripts/install-xray.sh и install-xray.ps1)
XRAY_SHA256=
PROBE_LOCATION=subscription-host
# По умолчанию data/probes; каталог доступен только системному пользователю сервиса
# PROBE_TEMP_DIR=/opt/vpn-subscriptions/data/probes
# DB_PATH=/opt/vpn-subscriptions/data/subscription.db
# SESSION_DIR=/opt/vpn-subscriptions/data/sessions
BACKUP_RETENTION_COUNT=7

SOURCE_SYNC_INTERVAL_SECONDS=1800
SOURCE_TIMEOUT_SECONDS=15
SOURCE_MAX_BYTES=5242880
SOURCE_MAX_NODES=1000
SOURCE_SYNC_CONCURRENCY=2

PROBE_INTERVAL_SECONDS=300
PROBE_HEALTH_TTL_SECONDS=1200
PROBE_READY_TIMEOUT_SECONDS=5
PROBE_ATTEMPT_TIMEOUT_SECONDS=5
PROBE_DEADLINE_SECONDS=40
PROBE_CONCURRENCY=4
PROBE_MAX_QUEUED=2000
PROBE_HISTORY_DAYS=7
PROBE_HISTORY_MAX_ROWS=50000
PROBE_PRIMARY_URL=https://www.gstatic.com/generate_204
PROBE_FALLBACK_URL=https://cp.cloudflare.com/generate_204
PROFILE_UPDATE_INTERVAL_HOURS=1
