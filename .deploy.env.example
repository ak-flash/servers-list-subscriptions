# Deployment project directory
PROJECT_DIR=/home/ubuntu/servers-list-subscriptions

# Git branch to deploy
DEPLOY_BRANCH=main

# Commands run after git pull
INSTALL_COMMAND="npm ci --no-audit --no-fund --loglevel=error"
BUILD_COMMAND="npm run build:css"

# Restart command. Examples:
# RESTART_COMMAND="sudo /www/server/panel/pyenv/bin/supervisorctl restart subcsriptions:subcsriptions_00"
# RESTART_COMMAND="sudo systemctl restart vpn-subscriptions.service"
# RESTART_COMMAND="docker compose up -d --build"
RESTART_COMMAND=""

# Post-deploy health check; the deploy rolls back to the previous commit on failure.
# HEALTHCHECK_URL=http://127.0.0.1:2096/healthz
# HEALTHCHECK_TIMEOUT=60
# ALLOW_NO_RESTART=1 — разрешить деплой без RESTART_COMMAND (только для не-production).
